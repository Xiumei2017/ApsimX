                          "Action": " // 'soil water' set sw = 0.157 0.246 0.273 0.291 0.318 0.349 0.382 0.406 0.373 0.339 0.331 0.322 0.310 0.298 0.274 0.251 0.251 0.251 0.251 0.251",
                          "Line": "2001-04-09  // 'soil water' set sw = 0.157 0.246 0.273 0.291 0.318 0.349 0.382 0.406 0.373 0.339 0.331 0.322 0.310 0.298 0.274 0.251 0.251 0.251 0.251 0.251"
