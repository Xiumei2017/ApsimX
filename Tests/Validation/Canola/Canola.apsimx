                          "Line": "1994-04-20  // 'soil water' set sw = 0.129 0.147 0.183 0.222 0.308 0.308 0.280 0.280 0.309 0.309 0.309 0.309 0.304 0.304 0.304 0.304 0.324 0.324 0.324 0.324"
                        },
