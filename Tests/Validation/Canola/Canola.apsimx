                          "Action": " // 'soil water' set sw = 0.111 0.163 0.169 0.187 0.209 0.23 0.231 0.232 0.227 0.222 0.213 0.204 0.203 0.202 0.202 0.202 0.202 0.202 0.202 0.202",
                          "Line": "2001-04-09  // 'soil water' set sw = 0.111 0.163 0.169 0.187 0.209 0.23 0.231 0.232 0.227 0.222 0.213 0.204 0.203 0.202 0.202 0.202 0.202 0.202 0.202 0.202"
