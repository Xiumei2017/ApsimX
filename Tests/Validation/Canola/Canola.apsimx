                          "Line": "2002-04-24  // 'soil nitrogen' set no3ppm = 45.0 10.5 7.1 6.9 6.4 6.0 4.5 3.1 2.8 2.4 2.3 2.2 2.1 1.9 1.4 0.9 0.9 0.9 0.9 0.9"
