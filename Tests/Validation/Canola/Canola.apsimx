                      "NaturalVegetation": null,
                      "ApsoilNumber": null,
                      "Latitude": 0.0,
                      "Longitude": 0.0,
                      "LocationAccuracy": null,
                      "YearOfSampling": null,
                      "DataSource": null,
                      "Comments": null,
                      "Name": "soil",
                      "ResourceName": null,
