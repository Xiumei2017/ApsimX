                          "Line": "1994-04-20  // 'soil nitrogen' set no3ppm = 67.1 11.3 8.3 5.0 2.4 2.4 1.1 1.1 0.9 0.9 0.9 1.3 1.3 1.3 1.3 1.7 1.7 1.7 1.7 1.7"
