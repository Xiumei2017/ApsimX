                                      "Value": "1"
                                    },
                                    {
                                      "Key": "irrig_treat",
                                      "Value": "nil"
                                    },
                                    {
                                      "Key": "trial_code",
                                      "Value": "CSTA16LONG3"
                                    },
                                    {
                                      "Key": "fert_code",
                                      "Value": "nil"
                                    }
                                  ],
