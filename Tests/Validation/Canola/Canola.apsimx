                          "Line": "2001-04-09  // 'soil nitrogen' set no3ppm = 126.0 42.0 28.0 18.0 13.5 9.0 6.0 3.0 2.0 1.0 1.5 2.0 1.90 1.8 1.25 0.7 0.7 0.7 0.7 0.7"
                        },
