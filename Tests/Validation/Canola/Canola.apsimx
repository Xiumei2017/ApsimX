                          "Line": "2002-04-24  // 'soil nitrogen' set no3ppm = 45.5 7.2 2.7 1.8 1.3 0.8 0.9 1.0 0.8 0.6 0.6 0.6 0.5 0.5 0.6 0.6 0.6 0.6 0.6 0.6"
