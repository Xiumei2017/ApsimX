                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Interfaces;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "using Models.Soils;",
                                    "using Models.Soils.Nutrients;",
                                    "using Models.Utilities;",
                                    "using Models.Surface;",
                                    "using APSIM.Shared.Utilities;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] private Clock Clock;",
                                    "        [Link] private Plant Wheat;",
                                    "        [Link] private ISoilWater SoilWater;",
                                    "        [Link] private INutrient nutrient;",
                                    "        [Link] private SurfaceOrganicMatter SOM;",
                                    "        [Link] private Summary summary;",
                                    "",
                                    "        [Description(\"Date to reset on:\")]",
                                    "        public string ResetDate {get;set;}",
                                    "",
                                    "        [Description(\"Reset Water?\")]",
                                    "        public string ResetWater {get;set;}",
                                    "",
                                    "        [Description(\"Reset Nitrogen?\")]",
                                    "        public string ResetN {get;set;}",
                                    "",
                                    "        [Description(\"Reset Surface Organic Matter?\")]",
                                    "        public string ResetSOM {get;set;}",
                                    "",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            if (DateUtilities.WithinDates(ResetDate, Clock.Today, ResetDate))",
                                    "            {",
                                    "                if (ResetWater == \"Yes\")",
                                    "                {",
                                    "                    summary.WriteMessage(this, \"Reset Water\", MessageType.Diagnostic);",
                                    "                    SoilWater.Reset();",
                                    "                }",
                                    "                if (ResetN == \"Yes\")",
                                    "                {",
                                    "                    summary.WriteMessage(this, \"Reset Nitrogen\", MessageType.Diagnostic);",
                                    "                    nutrient.Reset();",
                                    "                }",
                                    "                if (ResetSOM == \"Yes\")",
                                    "                {",
                                    "                    summary.WriteMessage(this, \"Reset Surface OM\", MessageType.Diagnostic);",
                                    "                    SOM.Reset();",
                                    "                }",
                                    "            }",
                                    "        }",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "ResetDate",
                                      "Value": "05-Apr"
                                    },
                                    {
                                      "Key": "ResetWater",
                                      "Value": "Yes"
                                    },
                                    {
                                      "Key": "ResetN",
                                      "Value": "Yes"
                                    },
                                    {
                                      "Key": "ResetSOM",
                                      "Value": "No"
                                    }
                                  ],
                                  "Name": "Reset on date",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using APSIM.Shared.Utilities;",
                                    "using Models.Utilities;",
                                    "using Models.Soils;",
                                    "using Models.PMF;",
                                    "using Models.Core;",
                                    "using System;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "        [Link] Fertiliser Fertiliser;",
                                    "        [Link] Summary Summary;",
                                    "        [Link] Plant Canola;",
                                    "        [Link] Soil Soil;",
                                    "        Accumulator accumulatedRain;",
                                    "        ",
                                    "        [Description(\"Sowing date (d-mmm)\")]",
                                    "        public string SowDate { get; set; }",
                                    "        [Description(\"Cultivar to be sown\")]",
                                    "        public string CultivarName { get; set; }",
                                    "        [Description(\"Sowing depth (mm)\")]",
                                    "        public double SowingDepth { get; set; }",
                                    "        [Description(\"Row spacing (mm)\")]",
                                    "        public double RowSpacing { get; set; }",
                                    "        [Description(\"Plant population (/m2)\")]",
                                    "        public double Population { get; set; }",
                                    "      ",
                                    "        ",
                                    "",
                                    "",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            if (DateUtilities.DatesAreEqual(SowDate, Clock.Today))",
                                    "            {",
                                    "                Canola.Sow(population: Population, cultivar: CultivarName, depth: SowingDepth, rowSpacing: RowSpacing);    ",
                                    "            }",
                                    "        ",
                                    "        }",
                                    "        ",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "SowDate",
                                      "Value": "06-Apr"
                                    },
                                    {
                                      "Key": "CultivarName",
                                      "Value": "Hyola575_CL"
                                    },
                                    {
                                      "Key": "SowingDepth",
                                      "Value": "20"
                                    },
                                    {
                                      "Key": "RowSpacing",
                                      "Value": "250"
                                    },
                                    {
                                      "Key": "Population",
                                      "Value": "45"
                                    }
                                  ],
                                  "Name": "Sowing",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "using APSIM.Shared.Utilities;",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "        [Link] Fertiliser Fertiliser;",
                                    "        ",
                                    "        [Separator(\"A component to apply fertiliser on one or more dates on every year of the simulation\")]",
                                    "",
                                    "        [Description(\"Type of fertiliser to apply? \")] [Display(Type = DisplayType.FertiliserType)]public string FertiliserType { get; set; }",
                                    "",
                                    "        [Description(\"Enter the fertilisation dates as dd-mmm with comma separation (any year information entered will be ignored): \")] public string[] FertiliserDates { get; set; } ",
                                    "",
                                    "        [Description(\"Amount of fertiliser to be applied (kg /ha)\")] public double Amount { get; set; }",
                                    "",
                                    "        [Description(\"Is the above amount to be applied each time? (yes/ticked)? Or is it the total annual amount across all dates (no/unticked)\")] public bool AmountType { get; set; }",
                                    "        ",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            foreach (string ddMMM in FertiliserDates)",
                                    "            {",
                                    "                if (DateUtilities.DatesEqual(ddMMM, Clock.Today))",
                                    "                {",
                                    "                    if (AmountType)",
                                    "                        Fertiliser.Apply(amount: Amount, type: FertiliserType);",
                                    "                    else",
                                    "                        Fertiliser.Apply(amount: Amount / FertiliserDates.Length, type: FertiliserType);",
                                    "                }",
                                    "            }",
                                    "        }",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "FertiliserType",
                                      "Value": "UreaN"
                                    },
                                    {
                                      "Key": "FertiliserDates",
                                      "Value": "06-apr"
                                    },
                                    {
                                      "Key": "Amount",
                                      "Value": "108"
                                    },
                                    {
                                      "Key": "AmountType",
                                      "Value": "True"
                                    }
                                  ],
                                  "Name": "Fertilise on fixed dates",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "",
                                    "        [Description(\"location\")]",
                                    "        public string location { get; set; }",
                                    "",
                                    "        [Description(\"Time of sowing\")]",
                                    "        public string TOS_index { get; set; }",
                                    "",
                                    "        [Description(\"irrig_treat\")]",
                                    "        public string irrig_treat { get; set; }",
                                    "",
                                    "        [Description(\"fert_treat\")]",
                                    "        public string fert_treat { get; set; }",
                                    "",
                                    "        [Description(\"trial_code\")]",
                                    "        public string trialcode { get; set; }",
                                    "",
                                    "        [EventSubscribe(\"StartOfSimulation\")]",
                                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                    "        {",
                                    "          }",
                                    "      ",
                                    "",
                                    "                                          /*",
                                    "                location = '[location]' !'Condobolin'",
                                    "irrig_treat = '[irrig_treat]' ! 'dry'",
                                    "fert_treat = '[fert_treat]' ! 'nil'",
                                    "trial_code = '[trial_code]' ! 'CSTB16COND2'",
                                    "minn_tot = 0",
                                    "TOS_index = [TOS_index] !'1'",
                                    "exp = '2a'",
                                    "            */",
                                    "        }",
                                    "    }"
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "location",
                                      "Value": "AlmaPark"
                                    },
                                    {
                                      "Key": "TOS_index",
                                      "Value": "1"
                                    },
                                    {
                                      "Key": "irrig_treat",
                                      "Value": ""
                                    },
                                    {
                                      "Key": "fert_treat",
                                      "Value": "nil"
                                    },
                                    {
                                      "Key": "trialcode",
                                      "Value": ""
                                    }
                                  ],
                                  "Name": "codes",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Climate;",
                                    "using Models.Core;",
                                    "using Models.PMF.Phen;",
                                    "using Models.PMF;",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "        [Link] Weather wtr;",
                                    "        [Link] private Plant canola;",
                                    "        [Link(Type = LinkType.Path, Path = \"[canola].Phenology\")]",
                                    "        private Phenology phenology;",
                                    "        private int cum_days;",
                                    "        private double cum_temp;",
                                    "        private double cum_swdef;",
                                    "        public double oil_conc { get; set; }",
                                    "",
                                    "",
                                    "        [EventSubscribe(\"StartOfSimulation\")]",
                                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                    "        {",
                                    "            cum_temp = 0;",
                                    "            cum_swdef = 0;",
                                    "            cum_days = 0;",
                                    "            oil_conc = 0;",
                                    "        }",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            double avg_temp;",
                                    "            double avg_swdef;",
                                    "            ",
                                    "            if (canola.DaysAfterSowing == 1)",
                                    "            {",
                                    "                cum_temp = 0;",
                                    "                cum_swdef = 0;",
                                    "                cum_days = 0;",
                                    "            }",
                                    "            else if ((phenology.CurrentPhase.Name == \"EarlyGrainFilling\") ||",
                                    "                (phenology.CurrentPhase.Name == \"MidGrainFilling\") ||",
                                    "                (phenology.CurrentPhase.Name == \"LateGrainFilling\") ||",
                                    "                (phenology.CurrentPhase.Name == \"Maturing\") ||",
                                    "                (phenology.CurrentPhase.Name == \"Ripening\") ||",
                                    "                (phenology.CurrentPhase.Name == \"ReadyForHarvesting\"))",
                                    "            {",
                                    "                cum_temp += (wtr.MaxT + wtr.MinT) / 2;",
                                    "                //cum_swdef += swdef_photo;  // TODO: determine if swdef_photo can be found and used",
                                    "                cum_days++;",
                                    "            }",
                                    "            else",
                                    "            {",
                                    "                cum_days = 0;",
                                    "            }",
                                    "",
                                    "             // calculate canola oil content",
                                    "             if (cum_days > 0) ",
                                    "             {",
                                    "                avg_temp = cum_temp / cum_days;",
                                    "                avg_swdef = cum_swdef / cum_days;",
                                    "                if (avg_temp <= 14)",
                                    "                       oil_conc =  47;",
                                    "                else",
                                    "                       oil_conc = (47 - ((avg_temp - 14)*1.21)) - (1.91*(1 - Math.Pow(avg_swdef,2)));",
                                    "            }",
                                    "             else",
                                    "                oil_conc = 0;",
                                    "             ",
                                    "        }",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [],
                                  "Name": "Canola Oil Conc Calculator",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "",
                                    "        [EventSubscribe(\"StartOfSimulation\")]",
                                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                    "        {",
                                    "            /*",
                                    "                frost_multiplier=1",
                                    "heat_multiplier=1",
                                    "cum_frost_multiplier=1",
                                    "cum_heat_multiplier=1",
                                    "heat_exposure= 0",
                                    "heat_stress_days = 0",
                                    "mild_heat_stress_days = 0",
                                    "mod_heat_stress_days = 0",
                                    "sev_heat_stress_days = 0",
                                    "",
                                    "frost_exposure = 0",
                                    "",
                                    "mild_frost_days = 0",
                                    "mod_frost_days = 0",
                                    "sev_frost_days = 0",
                                    "frost_days = 0",
                                    "",
                                    "FrostHeatYield = 0",
                                    "FrostHeatYieldWet = 0",
                                    "FrostHeatGrain_Wt = 0",
                                    "",
                                    "old_FrostHeatGrain = 0",
                                    "",
                                    "canola_in = 0",
                                    "",
                                    "",
                                    "! This work comes from:",
                                    "!   Julianne M. Lilley, Lindsay W. Bell, and John A. Kirkegaard ",
                                    "!     (2015) Optimising grain yield and grazing potential of crops across Australia’s ",
                                    "!     high-rainfall zone: a simulation analysis. 2. Canola, ",
                                    "!     Crop & Pasture Science, 66, 349-364",
                                    "",
                                    "",
                                    "old_cum_frost_multiplier=1",
                                    "old_cum_heat_multiplier=1",
                                    "frost_multiplier_eq=1",
                                    "heat_multiplier_eq=1",
                                    "stage_factor_heat = 1",
                                    "stage_factor_frost = 1",
                                    "final_heat_multiplier = 1",
                                    "final_frost_multiplier = 1",
                                    "",
                                    "            */",
                                    "        }",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            /*",
                                    "                !Rules for calculation of heat and frost risk",
                                    "            ",
                                    "degree_days = (mint + maxt) / 2",
                                    "if (canola.stage >= 6) then",
                                    "   cum_degree_days = degree_days + cum_degree_days",
                                    "else ",
                                    "   cum_degree_days = 0",
                                    "endif",
                                    "            ",
                                    "if (cum_degree_days > 0 and cum_degree_days < 630 then ! 630 degree days approx 6 weeks @ 15 dd / day; approx flowering window",
                                    "   heat_exposure = 1",
                                    "else ",
                                    "   heat_exposure = 0",
                                    "endif",
                                    "            ",
                                    "",
                                    "if (cum_degree_days > 140 and cum_degree_days < 800) then ! 140 degree days approx 2 weeks @ 10 dd / day, to 6weeks after that",
                                    "                                                          ! approx water pod window",
                                    "   frost_exposure = 1",
                                    "else ",
                                    "   frost_exposure = 0",
                                    "endif",
                                    "    ",
                                    "if (canola.stage > 0) then  ! reset  each day",
                                    "   canola_in = 1",
                                    "   frost_multiplier = 1  ",
                                    "   heat_multiplier = 1",
                                    "   frost_multiplier_eq = 1  ",
                                    "   heat_multiplier_eq = 1",
                                    "   stage_factor_heat = 1",
                                    "   stage_factor_frost = 1",
                                    "   final_heat_multiplier = 1",
                                    "   final_frost_multiplier = 1",
                                    "   frost_days = 0",
                                    "   mild_frost_days = 0",
                                    "   mod_frost_days = 0",
                                    "   sev_frost_days = 0",
                                    "   heat_stress_days = 0",
                                    "   mild_heat_stress_days = 0",
                                    "   mod_heat_stress_days = 0   ",
                                    "   sev_heat_stress_days = 0",
                                    "else",
                                    "   canola_in = 0",
                                    "endif",
                                    "",
                                    "",
                                    "",
                                    "if (heat_exposure = 1 AND maxt >= 30) then",
                                    " heat_multiplier_eq = -0.075*maxt + 3.25 ! heat_multiplier_eq = -0.0582*maxt + 2.7465",
                                    "      if heat_multiplier_eq > 1 then",
                                    "         heat_multiplier_eq = 1",
                                    "      endif",
                                    "      if heat_multiplier_eq < 0.65 then",
                                    "         heat_multiplier_eq = 0.65",
                                    "      endif",
                                    "",
                                    "         !!!!!!!!!!!!!!!!!!!!!!!! new section - heat !!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "   if cum_degree_days<=300 then",
                                    "      stage_factor_heat = cum_degree_days * 1.5/300  ! stage_factor_heat = cum_degree_days /300",
                                    "   else",
                                    "      stage_factor_heat = 3 - cum_degree_days * 1.5/ 300  ! stage_factor_heat = 2 - cum_degree_days /300",
                                    "   endif",
                                    "",
                                    "   if stage_factor_heat >1 then",
                                    "       stage_factor_heat = 1",
                                    "   endif",
                                    "   if stage_factor_heat <0 then",
                                    "       stage_factor_heat = 0",
                                    "   endif",
                                    "",
                                    "   final_heat_multiplier = 1-((1-heat_multiplier_eq )*stage_factor_heat )",
                                    "         !!!!!!!!!!!!!!!!!!!!!!!! new section finish !!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "endif",
                                    "",
                                    "if (frost_exposure = 1 AND mint <= 2 ) then  ! constrain to below 0, limit damage below -4 (where it = 0.9)",
                                    "     frost_multiplier_eq = 0.025*mint + 1",
                                    "   ",
                                    "     if frost_multiplier_eq >1 then",
                                    "         frost_multiplier_eq = 1",
                                    "     endif",
                                    "     if frost_multiplier_eq <0.9 then",
                                    "        frost_multiplier_eq = 0.9",
                                    "     endif",
                                    "         !!!!!!!!!!!!!!!!!!!!!!!! new section - frost !!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "     if cum_degree_days<=440 then",
                                    "        stage_factor_frost = (cum_degree_days - 140) *1.5/300       stage_factor_frost = (cum_degree_days - 140) /300",
                                    "     else",
                                    "        stage_factor_frost = 3 - (cum_degree_days - 140) *1.5/300  !     stage_factor_frost = 2 - (cum_degree_days - 140) /300",
                                    "     endif",
                                    "",
                                    "     if stage_factor_frost >1 then",
                                    "        stage_factor_frost = 1",
                                    "     endif",
                                    "     if stage_factor_frost <0 then",
                                    "        stage_factor_frost = 0",
                                    "     endif",
                                    "",
                                    "     final_frost_multiplier = 1-((1-frost_multiplier_eq )*stage_factor_frost )",
                                    "         !!!!!!!!!!!!!!!!!!!!!!!! new section finish !!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "endif",
                                    "",
                                    "!!!!!!!!!!!!!! origingal Frost/heat !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "                   ",
                                    "if (heat_exposure = 1 and maxt >= 30) then ",
                                    "   heat_stress = 1",
                                    "else",
                                    "   heat_stress = 0",
                                    "endif",
                                    "                       ",
                                    "if (frost_exposure = 1 and mint <= 2) then",
                                    "   light_frost_stress = 1",
                                    "else ",
                                    "   light_frost_stress = 0",
                                    "endif",
                                    "                        ",
                                    "if (frost_exposure = 1 and mint <= 0) then",
                                    "   heavy_frost_stress = 1",
                                    "else ",
                                    "   heavy_frost_stress = 0",
                                    "endif",
                                    "            ",
                                    "",
                                    "if (heat_exposure = 1 AND maxt >= 30 AND maxt < 33) then",
                                    "   heat_multiplier = 0.9",
                                    "   mild_heat_stress_days = 1 ",
                                    "endif",
                                    "",
                                    "if (heat_exposure = 1 AND maxt >= 33 AND maxt < 36) then",
                                    "   heat_multiplier = 0.82",
                                    "   mod_heat_stress_days = 1   ",
                                    "endif",
                                    "",
                                    "if (heat_exposure = 1 AND maxt >= 36) then ",
                                    "   heat_multiplier = 0.65",
                                    "   sev_heat_stress_days = 1",
                                    "endif",
                                    "",
                                    "",
                                    "if (frost_exposure = 1 AND mint <= 2 AND mint > 0) then",
                                    "    frost_multiplier = 1.0",
                                    "    mild_frost_days = 1",
                                    "endif",
                                    "",
                                    "if (frost_exposure = 1 AND mint <= 0 AND mint > -2) then",
                                    "    frost_multiplier = 0.98",
                                    "    mod_frost_days = 1",
                                    "endif",
                                    "",
                                    "if (frost_exposure = 1 AND mint <= -2) then",
                                    "    frost_multiplier = 0.90",
                                    "    sev_frost_days = 1",
                                    "endif",
                                    "",
                                    "frost_days = mild_frost_days + mod_frost_days + sev_frost_days",
                                    "heat_stress_days =  mild_heat_stress_days + mod_heat_stress_days + sev_heat_stress_days ",
                                    "",
                                    "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
                                    "",
                                    "if (canola.stagename = 'sowing') then",
                                    "   cum_heat_stress = 0",
                                    "   cum_light_frost_stress = 0",
                                    "   cum_heavy_frost_stress = 0",
                                    "   cum_frost_multiplier=1",
                                    "   old_cum_heat_multiplier=1",
                                    "   old_cum_frost_multiplier=1",
                                    "   cum_heat_multiplier=1",
                                    "   FrostHeatYield = 0",
                                    "   FrostHeatYieldWet = 0",
                                    "   FrostHeatGrain_wt = 0",
                                    "endif",
                                    "          ",
                                    "if (cum_degree_days > 0 and cum_degree_days < 800) then  ! no longer just 630",
                                    "    cum_heat_stress=cum_heat_stress + heat_stress",
                                    "    cum_light_frost_stress=cum_light_frost_stress + light_frost_stress",
                                    "    cum_heavy_frost_stress=cum_heavy_frost_stress + heavy_frost_stress",
                                    "    cum_frost_multiplier=cum_frost_multiplier * final_FROST_multiplier  ! new equation running using critical period factor",
                                    "    cum_heat_multiplier=cum_heat_multiplier * final_HEAT_multiplier     ! new equation running using critical period factor",
                                    "  ! cum_frost_multiplier=cum_frost_multiplier * frost_multiplier_eq  ! new equation running ",
                                    "  ! cum_heat_multiplier=cum_heat_multiplier * heat_multiplier_eq     ! new equation running",
                                    "    old_cum_frost_multiplier=old_cum_frost_multiplier * frost_multiplier  ! new equation running",
                                    "    old_cum_heat_multiplier=old_cum_heat_multiplier * heat_multiplier     ! new equation running",
                                    "endif",
                                    "  ",
                                    "if (canola.yield > 0) then",
                                    "   old_FrostHeatGrain_wt=canola.Grain_wt*old_cum_frost_multiplier*old_cum_heat_multiplier",
                                    "   FrostHeatGrain_wt=canola.Grain_wt*cum_frost_multiplier*cum_heat_multiplier",
                                    "   FrostHeatYield=canola.Yield*cum_frost_multiplier*cum_heat_multiplier",
                                    "   FrostHeatYieldWet=canola.Yieldwet*cum_frost_multiplier*cum_heat_multiplier",
                                    "   HIfh = FrostheatGrain_wt /  canola.biomass_wt",
                                    "   HI = canola.grain_wt / canola.biomass_wt",
                                    "endif",
                                    "            */",
                                    "        }",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [],
                                  "Name": "CanolaFrostHeat",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using System.Text;",
                                    "using Models.PMF;",
                                    "using Models;",
                                    "using APSIM.Shared.Utilities;",
                                    "using Models.PMF.Phen;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable] ",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] ISummary summary;",
                                    "        [Link] private Plant canola;",
                                    "        [Link(Type = LinkType.Path, Path = \"[canola].Phenology\")]",
                                    "        private Phenology phenology;",
                                    "                [Link] Clock Clock;",
                                    "",
                                    "        private bool Harvestable = false;",
                                    "",
                                    "        [Description(\"Harvest Date (d-mmm)\")]",
                                    "        public string HarvestDate { get; set; }   ",
                                    "      ",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "           ",
                                    "            if (Harvestable && phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                                    "            {",
                                    "                canola.Harvest();",
                                    "                canola.EndCrop();                ",
                                    "            }",
                                    "            ",
                                    "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                                    "                Harvestable = true;",
                                    "",
                                    "        }",
                                    "    }",
                                    "}",
                                    "       "
