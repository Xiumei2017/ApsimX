                      "ProtDg": 0.0,
                      "PConc": 0.0,
                      "SConc": 0.0,
                      "EEConc": 0.0,
                      "ADIP2CP": 0.0,
                      "AshAlk": 0.0,
                      "MaxPassage": 0.0
