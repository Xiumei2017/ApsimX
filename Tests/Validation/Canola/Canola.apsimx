                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock clock;    ",
                                    "           [Link] Irrigation irrigation;",
                                    "",
                                    "           [Description(\"Date for irrigation\")] ",
                                    "        public string irrigDate { get; set; }",
                                    "",
                                    "        [Description(\"Amount of irrigation (mm)\")]",
                                    "        public double amount {get; set; }",
                                    "",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            if (DateUtilities.DatesAreEqual(irrigDate, clock.Today))",
                                    "                irrigation.Apply(amount: amount);",
                                    "        }",
                                    "    }",
                                    "}",
                                    "            "
                                  ],
                                  "Parameters": [
