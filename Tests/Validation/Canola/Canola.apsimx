                                    "",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            foreach (string ddMMM in irrigDates)",
                                    "            {",
                                    "                if (DateUtilities.DatesEqual(ddMMM, clock.Today))",
                                    "                    irrigation.Apply(amount: amount);",
                                    "            }",
                                    "        }",
                                    "    }",
                                    "}",
                                    "            "
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "irrigDates",
                                      "Value": ""
                                    },
                                    {
                                      "Key": "amount",
                                      "Value": "0"
                                    }
                                  ],
                                  "Name": "Irrigate",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using System.Text;",
                                    "using Models.PMF;",
                                    "using Models;",
                                    "using APSIM.Shared.Utilities;",
                                    "using Models.PMF.Phen;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable] ",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] ISummary summary;",
                                    "        [Link] private Plant canola;",
                                    "        [Link(Type = LinkType.Path, Path = \"[canola].Phenology\")]",
                                    "        private Phenology phenology;",
                                    "                [Link] Clock Clock;",
                                    "",
                                    "        private bool Harvestable = false;",
                                    "",
                                    "        [Description(\"Harvest Date (d-mmm)\")]",
                                    "        public string HarvestDate { get; set; }   ",
                                    "      ",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "           ",
                                    "            if (Harvestable && phenology.CurrentPhase.Name == \"ReadyForHarvesting\")",
                                    "            {",
                                    "                canola.Harvest();",
                                    "                canola.EndCrop();                ",
                                    "            }",
                                    "            ",
                                    "            if (DateUtilities.DatesAreEqual(HarvestDate, Clock.Today))",
                                    "                Harvestable = true;",
                                    "",
                                    "        }",
                                    "    }",
                                    "}",
                                    "       "
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "HarvestDate",
                                      "Value": "8-Nov"
                                    }
                                  ],
                                  "Name": "HarvestAfterDate",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": false,
                                  "ReadOnly": false
                                }
                              ],
                              "Enabled": false,
                              "ReadOnly": false
                            },
