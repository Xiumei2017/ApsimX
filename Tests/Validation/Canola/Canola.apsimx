                    },
                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Models.Soils;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Clock Clock;",
                        "",
                        "        [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void OnSimulationCommencing(object sender, EventArgs e)",
                        "        {",
                        "            /*",
                        "                ",
                        "            samp_start_sw = 0",
                        "            rain_samp_start_sw = 0",
                        "            rain_samp_finish_sw = 0",
                        "            sim_start_sw = 0",
                        "            sim_finish_sw = 0",
                        "            cum_days = 0",
                        "            pre_sow_rain = 0",
                        "            flower_flag = 0",
                        "            grain_fill_rain = 0",
                        "            sum_rain = 0",
                        "            in_crop_rain = 0",
                        "            num_rain_events = 0",
                        "            ",
                        "            */",
                        "        }",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            /*",
                        "                ",
                        "               if (daysaftersowing = 1) then",
                        "                  cum_temp = 0",
                        "                  cum_swdef = 0",
                        "                  cum_days = 0",
                        "               elseif (stagename = 'start_grain_fill' or",
                        "                             stagename = 'end_grain_fill' or",
                        "                             stagename = 'maturity' or",
                        "                             stagename = 'harvest_ripe') then",
                        "                  cum_temp = cum_temp + (maxt + mint) / 2",
                        "                  cum_swdef = cum_swdef + swdef_photo",
                        "                  cum_days = cum_days + 1",
                        "               endif",
                        "               ! calculate canola oil content",
                        "               if (cum_days > 0) then",
                        "                  avg_temp = cum_temp / cum_days",
                        "                  avg_swdef = cum_swdef / cum_days",
                        "                  if (avg_temp <= 14) then",
                        "                     oil_conc =  47",
                        "                  else",
                        "                     oil_conc = (47 - ((avg_temp - 14)*1.21)) - (1.91*(1 - avg_swdef^2))",
                        "                  endif",
                        "               else",
                        "                  oil_conc = 0",
                        "               endif",
                        "            ",
                        "            */",
                        "            /*",
                        "                ",
                        "            if year = 2003 and day = 104 then",
                        "              sim_start_sw = esw",
                        "            endif",
                        "            ",
                        "            */",
                        "        }",
                        "        [EventSubscribe(\"DoCalculations\")]",
                        "        private void OnDoCalculations(object sender, EventArgs e)",
                        "        {",
                        "            /*",
                        "                ",
                        "            if day = 100 then",
                        "                 accum_es = 0",
                        "            endif",
                        "            if canola.daysaftersowing = 1 then",
                        "               start_esw = esw",
                        "               sow_day = day",
                        "            endif",
                        "            if canola.plant_status = 'out' then",
                        "               pre_sow_rain = pre_sow_rain + rain",
                        "            endif",
                        "            if canola.daysaftersowing > 0 then",
                        "                 accum_es = accum_es + es",
                        "                 in_crop_rain = in_crop_rain + rain",
                        "            endif",
                        "            if canola.daysaftersowing > 0 and rain > 3 then",
                        "                 num_rain_events = num_rain_events + 1",
                        "            endif",
                        "            if canola.stagename = 'flowering' and flower_flag = 0 then",
                        "               pre_flower_rain = in_crop_rain",
                        "               pre_flower_rain_events = num_rain_events",
                        "               flower_lai = lai",
                        "               flower_flag = 1",
                        "               grain_fill_rain = 0",
                        "            endif",
                        "            grain_fill_rain = grain_fill_rain + rain",
                        "            if canola.stagename = 'harvest_ripe' or canola.plant_status = 'dead' then",
                        "               total_rain_events = num_rain_events",
                        "               end_esw = esw",
                        "               canola harvest",
                        "               canola kill_crop",
                        "               canola end_crop",
                        "               in_crop_rain = 0",
                        "               crop_in = 0",
                        "               flower_flag = 0",
                        "               pre_sow_rain = 0",
                        "            endif",
                        "            if month = 1 and is_end_month = 1 then",
                        "              jan_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 2 and is_end_month = 1 then",
                        "              feb_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 3 and is_end_month = 1 then",
                        "              mar_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 4 and is_end_month = 1 then",
                        "              apr_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 5 and is_end_month = 1 then",
                        "              may_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 6 and is_end_month = 1 then",
                        "              jun_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 7 and is_end_month = 1 then",
                        "              jul_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 8 and is_end_month = 1 then",
                        "              aug_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 9 and is_end_month = 1 then",
                        "              sep_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 10 and is_end_month = 1 then",
                        "              oct_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 11 and is_end_month = 1 then",
                        "              nov_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            if month = 12 and is_end_month = 1 then",
                        "              dec_rain = sum_rain",
                        "              sum_rain = 0",
                        "            endif",
                        "            sum_rain = sum_rain + rain",
                        "            !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!  residue  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
                        "            ",
                        "            */",
                        "            /*",
                        "                ",
                        "            if year = 2003 and day = 105 then",
                        "              samp_start_sw = esw",
                        "              rain_samp_start_sw = pre_sow_rain",
                        "            endif",
                        "            ",
                        "            */",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [],
                      "Name": "manager",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": false,
                      "ReadOnly": false
                    },
