                                  "$type": "Models.Factorial.CompositeFactor, Models",
                                  "Specifications": [
                                    "[TreeTransplantRule].Script.CultivarName=grandisXurophyllaC3334",
                                    "[TreeTransplantRule].Script.SowingDate=2001-10-01"
                                  ],
                                  "Paths": null,
                                  "Values": null,
                                  "Name": "CultC3334",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
