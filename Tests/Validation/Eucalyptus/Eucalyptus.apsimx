            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "DroughtRiskSites",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "These experiments are described in [mendham2011soil], [white1996leaf], [white1998influence], [white2009managing], [white2010observed] and [white2014managing]. Experimental treatments were combinations of stocking and N fertilisation starting 2 years after planting. Additional data were provided by D. Mendham. A second rotation is described in these papers and data included in the observed file, but treatments were reallocated at the begining of the second rotation, and coppice rather than seedlings were used in most treatments for the second rotation. It would be useful and possible to include coppicing in the Eucalytpus model, but this has not yet been attempted. Other models in APSIM provide a basis for including coppicing, e.g. gliricidia, and lucerne.    \r\n\r\n\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
