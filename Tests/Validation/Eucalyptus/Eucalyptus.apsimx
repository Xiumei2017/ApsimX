            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "Westfield",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "This experiment is described in [smethurst1997paste], [smethurst2003fertilizer], [smethurst2004nitrogen], [smethurst2004simultaneous], [misra1998belowI], [misra1998belowI], and [resh2003coarse]. The experiment included nil to high cumulative rates of N and P fertilisers in an _E. nitens_ plantation. Other research suggested that three was little or no response to the P component of the fertiliser. Very high rates of fertiliser might have started to induced a base cation deficiency (Ca, Mg or K) by the latter stage of the rotation, as some acidification had occurred, but this was not investigated further.   \n\n\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
