                                "[Soil].Water.Volumetric[13]",
                                "[Soil].Water.Volumetric[14] as SW600",
                                "[Soil].Water.Volumetric[15]",
                                "[Soil].Water.Volumetric[16] as SW750",
                                "sum([Soil].Water.MM) as SWTotal",
                                "[Irrigation].IrrigationApplied"
