            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "Furadouro",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "This experiment is described in [madeira1990productivity], [madeira1995effects], [pereira2012biomass], [madeira2002changes], [fabiao1995development], [katterer1995fine], [quilho2001within], [pereira1994biomass], [pereira1989optimization], and [fontes2006calibration]. Experimental treatments were combinations of irrigation and fertilisation applied to _E. globulus._ Most growth response was to fertiliser, which included NPK, but only the IL treatment was simulated here, which assumes that nutrients othere than N were also present at adequate levels. \r\n\r\n\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
