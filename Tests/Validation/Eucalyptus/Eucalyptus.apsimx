            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "Name": "Forico",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "These data describe adjacent plantations of E. globulus and E. nitens, with part of the E. nitens plantation being thinned. The site was known as St Georges Road. We thank G. Holz, K. Joyce, and L. Cannon of Forico for data and other information about the site (formally the site was owned or managed by Gunns, North Forest Products and APPM). \n\n \n\n\r\n",
                  "Name": "Memo",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Experiment, Models",
                  "DisabledSimNames": null,
                  "Name": "Forico",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Factors, Models",
                      "Name": "Factors",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.Permutation, Models",
                          "Name": "Permutation",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Factorial.Factor, Models",
                              "Specification": "",
                              "Name": "StGRd",
                              "ResourceName": null,
                              "Children": [
                                {
                                  "$type": "Models.Factorial.CompositeFactor, Models",
                                  "Specifications": [
                                    "[Operations]",
                                    "[TreeManagement]"
                                  ],
                                  "Paths": null,
                                  "Values": null,
                                  "Name": "Eg",
                                  "ResourceName": null,
                                  "Children": [
                                    {
                                      "$type": "Models.Operations, Models",
                                      "OperationsList": [
                                        {
                                          "$type": "Models.Operation, Models",
                                          "Enabled": true,
                                          "Date": "1984-01-15",
                                          "Action": "[TreeThinning].Script.DoThin(0.13);",
                                          "Line": "1984-01-15 [TreeThinning].Script.DoThin(0.13);"
                                        }
                                      ],
                                      "Name": "Operations",
                                      "ResourceName": null,
                                      "Children": [],
                                      "Enabled": true,
                                      "ReadOnly": false
                                    },
                                    {
                                      "$type": "Models.Manager, Models",
                                      "CodeArray": [
                                        "",
                                        "using Models.Soils;",
                                        "using System;",
                                        "using Models.Core;",
                                        "using Models.PMF;",
                                        "using APSIM.Shared.Utilities;",
                                        "",
                                        "namespace Models",
                                        "{",
                                        "    [Serializable] ",
                                        "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                        "    public class Script : Model",
                                        "    {",
                                        "        [Link] Plant Plant;",
                                        "        [Link] Clock Clock;",
                                        "        [Link] Fertiliser Fertiliser;",
                                        "",
                                        "        public double TimeSincePlanting {get; set;}",
                                        "",
                                        "        [Description(\"Spacing (m) between plants within rows\")]",
                                        "        public double RowSpace { get; set; }",
                                        "",
                                        "        [Description(\"Spacing (m) between rows\")]",
                                        "        public double RowWidth { get; set; }",
                                        "",
                                        "        [Description(\"Cultivar\")]",
                                        "        [Display(Type=DisplayType.CultivarName)]",
                                        "        public string CultivarName { get; set; }",
                                        "",
                                        "        [Description(\"Planting Date (dd-mmm)\")]",
                                        "        public String PlantingDate { get; set; }",
                                        "",
                                        "        [Description(\"Harvest Age (years)\")]",
                                        "        public double HarvestAge { get; set; }",
                                        "",
                                        "        [Description(\"Amount of fertiliser N to be applied at planting (kg N/ha)\")]",
                                        "        public double FertAmount { get; set; }",
                                        "",
                                        "        [EventSubscribe(\"DoManagement\")]",
                                        "        private void OnDoManagement(object sender, EventArgs e)",
                                        "        {",
                                        "            double PlantPopulation = 1 / (RowWidth * RowSpace);",
                                        "            double RowWidthmm = RowWidth * 1000;",
                                        "",
                                        "            if (DateUtilities.WithinDates(PlantingDate, Clock.Today, PlantingDate) && !Plant.IsAlive)",
                                        "            {",
                                        "                Plant.Sow(population: PlantPopulation, ",
                                        "                    cultivar: CultivarName, ",
                                        "                    depth: 100, ",
                                        "                    rowSpacing: RowWidthmm);",
                                        "                TimeSincePlanting = 0;",
                                        "                Fertiliser.Apply(amount: FertAmount, type: \"NO3N\");",
                                        "            }",
                                        "",
                                        "            if (TimeSincePlanting > HarvestAge && Plant.IsAlive)",
                                        "            {",
                                        "               Plant.Harvest();",
                                        "               Plant.EndCrop();         ",
                                        "               TimeSincePlanting = 0;  ",
                                        "            }",
                                        "",
                                        "            TimeSincePlanting += 1.0/365.0;",
                                        "        }",
                                        "    }",
                                        "}",
                                        "                "
                                      ],
                                      "Parameters": [
                                        {
                                          "Key": "TimeSincePlanting",
                                          "Value": "0"
                                        },
                                        {
                                          "Key": "RowSpace",
                                          "Value": "3"
                                        },
                                        {
                                          "Key": "RowWidth",
                                          "Value": "3"
                                        },
                                        {
                                          "Key": "CultivarName",
                                          "Value": "globulus"
                                        },
                                        {
                                          "Key": "PlantingDate",
                                          "Value": "15-Nov"
                                        },
                                        {
                                          "Key": "HarvestAge",
                                          "Value": "26"
                                        },
                                        {
                                          "Key": "FertAmount",
                                          "Value": "23"
                                        }
                                      ],
                                      "Name": "TreeManagement",
                                      "ResourceName": null,
                                      "Children": [],
                                      "Enabled": true,
                                      "ReadOnly": false
                                    }
                                  ],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
