          "Children": [
            {
              "$type": "Models.Memo, Models",
              "Text": "This experiment is described in [cromer1993response] and [cromer1993responseN]. Some soil input data are from [ross1991soils]. Experimental treatments were factorial combinations of two levels each of irrigation and fertilisation applied to _E. grandis._ Most growth response was to fertiliser, which included NPK, but only N is simulated, which assumes that other nutrients were present at adequate levels. \r\n\r\n",
              "Name": "Memo",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            },
