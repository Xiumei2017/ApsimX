          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today",
            "Sum of ([Nutrient].MineralisedN[1]+[Nutrient].MineralisedN[2]+[Nutrient].MineralisedN[3]+[Nutrient].MineralisedN[4]) from [Clock].StartOfYear to [Clock].EndOfYear as NNMkgphaTop4DepthsAnnual",
            "Sum of [Irrigation].IrrigationApplied from [Clock].StartOfYear to [Clock].EndOfYear as IrrigationAppliedAnnual",
            "Sum of [Weather].Rain from [Clock].StartOfYear to [Clock].EndOfYear as AnnualRain",
            "Sum of [Weather].PanEvap from [Clock].StartOfYear to [Clock].EndOfYear as AnnualEvap",
            "Divide (AnnualRain,AnnualEvap) as AnnualCWI",
            "//Sum of [Nutrient].DenitrifiedN[] from [Clock].StartOfYear to [Clock].EndOfYear as DenitrifiedNkgperha"
          ],
          "EventNames": [
            "[Clock].EndOfYear"
          ],
          "GroupByVariableName": null,
          "Name": "AnnualReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today",
            "Sum of [Weather].Rain from [Clock].StartOfSimulation to [Clock].EndOfSimulation as SimRain",
            "Sum of [Weather].PanEvap from [Clock].StartOfSimulation to [Clock].EndOfSimulation as SimEvap",
            "Divide (SimRain,SimEvap) as SimCWI"
          ],
          "EventNames": [
            "[Clock].EndOfSimulation"
          ],
          "GroupByVariableName": null,
          "Name": "SimReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        }
      ],
      "Enabled": true,
