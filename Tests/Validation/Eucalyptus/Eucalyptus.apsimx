                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "These data are described in [borges2009parametrizaccao]. Two clones of the hybrid E. grandis x E. urophylla were included (C3334, C3336), but their measured differences were not significantly different. Hence, clonal differences were not simulated by specifiying partitioning targets as a genetic property.\r\n\r\n\r\n\r\n   \r\n\r\n\r\n\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
