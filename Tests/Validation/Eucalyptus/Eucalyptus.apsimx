                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "",
                                "using Models.Soils;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using APSIM.Shared.Utilities;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Plant Plant;",
                                "        [Link] Clock Clock;",
                                "        [Link] Fertiliser Fertiliser;",
                                "",
                                "        public double TimeSincePlanting {get; set;}",
                                "",
                                "        [Description(\"Spacing (m) between plants within rows\")]",
                                "        public double RowSpace { get; set; }",
                                "",
                                "        [Description(\"Spacing (m) between rows\")]",
                                "        public double RowWidth { get; set; }",
                                "",
                                "        [Description(\"Cultivar\")]",
                                "        [Display(Type=DisplayType.CultivarName)]",
                                "        public string CultivarName { get; set; }",
                                "",
                                "        [Description(\"Planting Date (dd-mmm)\")]",
                                "        public String PlantingDate { get; set; }",
                                "",
                                "        [Description(\"Harvest Age (years)\")]",
                                "        public double HarvestAge { get; set; }",
                                "",
                                "        [Description(\"Amount of fertiliser N to be applied at planting (kg N/ha)\")]",
                                "        public double FertAmount { get; set; }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            double PlantPopulation = 1 / (RowWidth * RowSpace);",
                                "            double RowWidthmm = RowWidth * 1000;",
                                "",
                                "            if (DateUtilities.WithinDates(PlantingDate, Clock.Today, PlantingDate) && !Plant.IsAlive)",
                                "            {",
                                "                Plant.Sow(population: PlantPopulation, ",
                                "                    cultivar: CultivarName, ",
                                "                    depth: 100, ",
                                "                    rowSpacing: RowWidthmm);",
                                "                TimeSincePlanting = 0;",
                                "                Fertiliser.Apply(amount: FertAmount, type: \"NO3N\");",
                                "            }",
                                "",
                                "            if (TimeSincePlanting > HarvestAge && Plant.IsAlive)",
                                "            {",
                                "               Plant.Harvest();",
                                "               Plant.EndCrop();         ",
                                "               TimeSincePlanting = 0;  ",
                                "            }",
                                "",
                                "            TimeSincePlanting += 1.0/365.0;",
                                "        }",
                                "    }",
                                "}",
                                "                "
                              ],
                              "Parameters": [
                                {
                                  "Key": "TimeSincePlanting",
                                  "Value": "0"
                                },
                                {
                                  "Key": "RowSpace",
                                  "Value": "2"
                                },
                                {
                                  "Key": "RowWidth",
                                  "Value": "4"
                                },
                                {
                                  "Key": "CultivarName",
                                  "Value": "WABlueGum"
                                },
                                {
                                  "Key": "PlantingDate",
                                  "Value": "15-Jun"
                                },
                                {
                                  "Key": "HarvestAge",
                                  "Value": "10"
                                },
                                {
                                  "Key": "FertAmount",
                                  "Value": "40"
                                }
                              ],
                              "Name": "TreeManagement",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Irrigation, Models",
                              "Name": "Irrigation",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "",
                                "using Models.PMF.Interfaces;",
                                "using Newtonsoft.Json;",
                                "using System;",
                                "using System.Collections.Generic;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.PMF.Interfaces;",
                                "using System.Xml.Serialization;",
                                "using Models.Soils;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Plant Eucalyptus;",
                                "        [Link] Clock Clock;",
                                "",
                                "",
                                "        ",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                "        {",
                                "            ",
                                "        }",
                                "        ",
                                "        //[EventSubscribe(\"DoManagement\")]",
                                "        public void DoThin(double ThinFr)",
                                "        {",
                                "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                                "",
                                "                //Harvest with manager specified removal fractions",
                                "                Eucalyptus.structure?.DoThin(ThinFr);",
                                "                var Leaf = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                                "                var Stem = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Stem\");",
                                "                var Branch = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Branch\");",
                                "                var FineRoot = Eucalyptus.FindChild<IHasDamageableBiomass>(\"FineRoot\");",
                                "                var CoarseRoot = Eucalyptus.FindChild<IHasDamageableBiomass>(\"CoarseRoot\");",
                                "                Leaf.RemoveBiomass(liveToRemove: ThinFr, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                                "                Stem.RemoveBiomass(liveToRemove: ThinFr, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                                "                Branch.RemoveBiomass(liveToRemove: ThinFr, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                                "                FineRoot.RemoveBiomass(liveToRemove: ThinFr, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                                "                CoarseRoot.RemoveBiomass(liveToRemove: ThinFr, deadToRemove: 0.0, liveToResidue: 0, deadToResidue: 0.0);",
                                "",
                                "                Eucalyptus.Population = Eucalyptus.Population*(1-ThinFr);",
                                "        }",
                                "    }",
                                "}",
                                "",
                                "                "
                              ],
                              "Parameters": [],
                              "Name": "TreeThinning",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Operations, Models",
                              "OperationsList": [],
                              "Name": "Operations",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Report, Models",
                              "VariableNames": [
                                "[Clock].Today",
                                "Sum of (([Nutrient].MineralisedN[1]+[Nutrient].MineralisedN[2]+[Nutrient].MineralisedN[3]+[Nutrient].MineralisedN[4])*10) from [Clock].StartOfYear to [Clock].EndOfYear as NNMkgphaTop4DepthsAnnual",
                                "Sum of [Irrigation].IrrigationApplied from [Clock].StartOfYear to [Clock].EndOfYear as IrrigationAppliedAnnual"
                              ],
                              "EventNames": [
                                "[Clock].EndOfYear"
                              ],
