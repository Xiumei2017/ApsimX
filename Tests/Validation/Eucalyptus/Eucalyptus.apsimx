                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today",
                            "[Eucalyptus].Stem.DBH",
                            "[Eucalyptus].Stem.Ht",
                            "[Eucalyptus].RootShootRatio",
