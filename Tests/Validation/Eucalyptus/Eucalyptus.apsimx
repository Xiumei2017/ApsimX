                            "using Models.PMF.Interfaces;",
                            "using System.Xml.Serialization;",
                            "using Models.Soils;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] Plant Eucalyptus;",
                            "        [Link] Clock Clock;",
                            "",
                            "",
                            "        ",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            ",
                            "        }",
                            "        ",
                            "        //[EventSubscribe(\"DoManagement\")]",
                            "        public void DoThin(double ThinFr)",
                            "        {",
                            "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                            "",
                            "                //Harvest with manager specified removal fractions",
                            "                Eucalyptus.structure?.DoThin(ThinFr);",
                            "                var Leaf = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                            "                var Stem = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Stem\");",
                            "                var Branch = Eucalyptus.FindChild<IHasDamageableBiomass>(\"Branch\");",
                            "                var FineRoot = Eucalyptus.FindChild<IHasDamageableBiomass>(\"FineRoot\");",
                            "                var CoarseRoot = Eucalyptus.FindChild<IHasDamageableBiomass>(\"CoarseRoot\");",
                            "                Leaf.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                            "                Stem.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                            "                Branch.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                            "                FineRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                            "                CoarseRoot.RemoveBiomass(liveToRemove: 0, deadToRemove: 0.0, liveToResidue: ThinFr, deadToResidue: 0.0);",
                            "",
                            "        }",
                            "    }",
                            "}",
                            "",
                            "                "
                          ],
