                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2001-01-15",
                                  "Action": "[Fertiliser].Apply(10, \"NH4N\", 0);",
                                  "Line": "2001-01-15 [Fertiliser].Apply(10, \"NH4N\", 0);"
                                }
