            "[Eucalyptus].Stem.Ht",
            "[Eucalyptus].RootShootRatio",
            "[Eucalyptus].Stem.Vol",
            "[Eucalyptus].Stem.MAI",
            "[Eucalyptus].Stem.BA",
            "[Eucalyptus].Stem.BarkThickness",
