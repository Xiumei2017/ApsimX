                          ],
                          "EventNames": [
                            "[Eucalyptus].Harvesting"
                          ],
                          "GroupByVariableName": null,
                          "Name": "HarvestReport",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
