                                  "OperationsList": [
                                    {
                                      "$type": "Models.Operation, Models",
                                      "Enabled": true,
                                      "Date": "2001-10-11",
                                      "Action": "[Fertiliser].Apply(150, \"NH4N\", 0);",
                                      "Line": "2001-10-11 [Fertiliser].Apply(150, \"NH4N\", 0);"
                                    },
                                    {
