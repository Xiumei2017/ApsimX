            "[Eucalyptus].Leaf.CoverGreen",
            "[Eucalyptus].Leaf.SpecificLeafArea",
            "//[Eucalyptus].Leaf.SenescenceRate",
            "//[Eucalyptus].Leaf.LeafKillFraction",
            "[Eucalyptus].Leaf.LAI",
            "[Eucalyptus].Leaf.Fn",
            "[Eucalyptus].Leaf.Fw",
            "[Eucalyptus].TotalLive.Wt",
            "[Eucalyptus].IndividualTreeLiveWt",
            "[Eucalyptus].IndividualTreeStemWt",
            "[Eucalyptus].Stem.DBH",
            "[Eucalyptus].Stem.Ht",
            "[Eucalyptus].CoarseRoot.Wt",
            "[Eucalyptus].FineRoot.Wt",
            "[Eucalyptus].RootShootRatio",
            "[Eucalyptus].Stem.Vol",
            "[Eucalyptus].Stem.MAI",
            "[Eucalyptus].Stem.BA",
            "[Eucalyptus].Stem.BarkThickness",
            "[Eucalyptus].Stem.BarkWt",
            "[Eucalyptus].Stem.BarkDensity.BarkDensity",
            "[Eucalyptus].Stem.BAub",
            "[Eucalyptus].Stem.DBHub",
            "[Eucalyptus].Stem.MAIub",
            "[Eucalyptus].Stem.VolBark",
            "[Eucalyptus].Stem.Volub",
            "[Eucalyptus].Stem.WoodDensity as WD",
            "[Eucalyptus].Stem.WoodWt",
            "[Eucalyptus].Stem.Wt",
            "[Eucalyptus].Stem.Live.Wt",
            "sum([Soil].Water.MM) as SWTotal",
            "//sum ([Soil].NO3.kgha + [Soil].NH4.kgha) as MineralNkgpha",
            "//[SoilWater].Evaporation[1]",
            "//[SoilWater].Drainage[1]",
            "//[SoilWater].Flux[1]",
            "//[SoilWater].Flow[1]",
            "//[SoilWater].Infiltration[1]",
            "//[SoilWater].LateralFlow[1]",
            "//[SoilWater].LateralOutflow[1]",
            "//[SoilWater].Runoff[1]",
            "//[Eucalyptus].FineRoot.Depth",
            "//[Irrigation].IrrigationApplied",
            "//[Weather].Rain"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "Report",
          "ResourceName": null,
          "Children": [],
