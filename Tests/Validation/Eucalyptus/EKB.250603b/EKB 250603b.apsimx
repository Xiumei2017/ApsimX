                      "YearOfSampling": "2023",
                      "DataSource": "Soil and Landscape Grid of Australia. This soil parameter file was automatically generated from the GSM National Surfaces using pedotransfer functions.",
                      "Comments": "Landuse is Grazing natural vegetation",
                      "Name": "SLGAmodConvey",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Soils.Water, Models",
                          "Thickness": [
                            150.0,
                            150.0,
