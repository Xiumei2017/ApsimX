{
  "$type": "Models.Core.Simulations, Models",
  "Version": 201,
  "Name": "Simulations",
  "ResourceName": null,
  "Children": [
    {
      "$type": "Models.Memo, Models",
      "Text": "Simulations here are for 12 rates trials and 12 response trials of the EKB series of trials comparing various combinations of rates of N fertiliser applied in 2018 or 2019, and again in 2022, in states of WA, Vic and Tas. It includes calibrated soils (one per site) and genotypes (one each of nitens and globulus covering all sites). \n\nReports of results are available from FWPA. \n\nThe research was funded by FWPA (Project PNC478-1819 'Optimising Nutrition Management of Hardwood Plantations for Sustainable Productivity and Profitability' and project VNC590-2223 'Enhancing the Knowledge Base for Hardwood Plantation Management'), \npartner companies (PGO, WAPRES, ABP, Forico, Midway, RFF, and SFM), and \nCSIRO. \n\nResearchers were John McGrath, Barrie May, Philip Smethurst, Ian Dumbrell, Danielle Wiseman, and Tom Baker.  \n",
      "Name": "Simulation Notes",
      "ResourceName": null,
      "Children": [],
      "Enabled": true,
      "ReadOnly": false
    },
