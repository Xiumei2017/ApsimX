      "Children": [
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today",
            "[Eucalyptus].Age",
            "[Eucalyptus].Population*10000 as sph",
            "[Eucalyptus].Stem.DBH",
            "[Eucalyptus].Stem.Ht",
            "[Eucalyptus].Stem.MAIub",
            "[Eucalyptus].Stem.BA",
            "[Eucalyptus].Stem.Volub",
            "[Eucalyptus].Stem.WoodDensity",
            "[Eucalyptus].Leaf.Fn",
            "[Eucalyptus].Leaf.Fw",
            "[Eucalyptus].FineRoot.Depth",
            "[Eucalyptus].Stem.BarkThickness",
            "[Eucalyptus].Stem.DBHub",
            "[Eucalyptus].Stem.MAI",
            "[Eucalyptus].Stem.Volub",
            "[Eucalyptus].Stem.VolBark",
            "[Eucalyptus].Stem.Vol",
            "[Eucalyptus].Stem.WoodWt",
            "[Eucalyptus].Stem.Wt",
            "[Eucalyptus].Stem.BarkDensity",
            "",
            "[Stem].WoodWt*10/([Stem].Volub+0.0001) as CalculatedWD",
            "",
            "//(([Eucalyptus].Stem.DBH)+ ([Eucalyptus].Stem.Ht)*0.6)) as DGL",
            "//(([Eucalyptus].Stem.DBHub)+ ([Eucalyptus].Stem.Ht)*0.6)) as DGLub",
            "",
            "//sum of (0.65,0) as WDmaxWT",
            "//sum of (0.05,0) as WDminWT",
            "//sum of (WDmaxWT/0.888) as WDmaxBH",
            "//sum of (WDminWT+100) as WDminBH",
            "//(WDmaxBH +(WDminBH)*Exp(((0-0.65319)*[Eucalyptus].Age/4.6))^2.99))*1000 as BHglobulusWoodDensity ",
            "//([Eucalyptus].Stem.WoodDensity-78.4/0.888) as BHglobulusWoodDensity",
            "//([Eucalyptus].Stem.WoodDensity-2.8/1.0575) as BHnitensWoodDensity",
            "((0.65*0.888)+((0.34*1.2+0.10)-(0.65*0.888))*Exp(((0-0.65319)*[Eucalyptus].Age/4.6))^2.99))*1000 as BHglobulusWoodDensity",
            "((0.58*0.888)+((0.32*1.2+0.10)-(0.58*0.888))*Exp(((0-0.65319)*[Eucalyptus].Age/4))^2.99))*1000 as BHnitensWoodDensity",
            "",
            "[Eucalyptus].Leaf.RadiationIntercepted",
            "sum of ([Eucalyptus].Leaf.Wt*[Eucalyptus].Leaf.CarbonConcentration/100) from [Clock].StartOfDay to [Clock].EndOfDay as CGainLeaf",
            "sum of ([Eucalyptus].Branch.Wt*[Eucalyptus].Branch.CarbonConcentration/100) from [Clock].StartOfDay to [Clock].EndOfDay as CGainBranch",
            "sum of ([Eucalyptus].Stem.Wt*[Eucalyptus].Stem.CarbonConcentration/100) from [Clock].StartOfDay to [Clock].EndOfDay as CGainStem",
            "sum of ([Eucalyptus].CoarseRoot.Wt*[Eucalyptus].CoarseRoot.CarbonConcentration/100) from [Clock].StartOfDay to [Clock].EndOfDay as CGainCoarseRoot",
            "sum of ([Eucalyptus].FineRoot.Wt*[Eucalyptus].FineRoot.CarbonConcentration/100) from [Clock].StartOfDay to [Clock].EndOfDay as CGainFineRoot",
            "(CGainLeaf+CGainBranch+CGainStem+CGainCoarseRoot+CGainFineRoot) as CGainTotal"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "DailyReport",
          "ResourceName": null,
