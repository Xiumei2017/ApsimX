                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "",
                        "using Models.Soils;",
                        "using System.Linq;",
                        "using System;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using APSIM.Shared.Utilities;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable] ",
                        "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                        "    public class Script : Model",
                        "    {",
                        "        [Link] Plant Eucalyptus;",
                        "        [Link] Clock Clock;",
                        "        [Link] Fertiliser Fertiliser;",
                        "",
                        "        public double TimeSincePlanting {get; set;}",
                        "",
                        "        [Description(\"Spacing (m) between plants within rows\")]",
                        "        public double RowSpace { get; set; }",
                        "",
                        "        [Description(\"Spacing (m) between rows\")]",
                        "        public double RowWidth { get; set; }",
                        "",
                        "        [Description(\"Cultivar\")]",
                        "        [Display(Type=DisplayType.CultivarName, PlantName = \"Eucalyptus\")]",
                        "        public string CultivarName { get; set; }",
                        "",
                        "        [Description(\"Planting Date (dd-mmm)\")]",
                        "        public String PlantingDate { get; set; }",
                        "",
                        "        [Description(\"Harvest Age (years)\")]",
                        "        public double HarvestAge { get; set; }",
                        "",
                        "        [Description(\"Amount of fertiliser N to be applied at planting (kg N/ha)\")]",
                        "        public double FertAmount { get; set; }",
                        "",
                        "        [EventSubscribe(\"DoManagement\")]",
                        "        private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            double PlantPopulation = 1 / (RowWidth * RowSpace);",
                        "            double RowWidthmm = RowWidth * 1000;",
                        "",
                        "            if (DateUtilities.WithinDates(PlantingDate, Clock.Today, PlantingDate) && !Eucalyptus.IsAlive)",
                        "            {",
                        "                Eucalyptus.Sow(population: PlantPopulation, ",
                        "                    cultivar: CultivarName, ",
                        "                    depth: 100, ",
                        "                    rowSpacing: RowWidthmm);",
                        "                TimeSincePlanting = 0;",
                        "                Fertiliser.Apply(amount: FertAmount, type: \"NO3N\");",
                        "            }",
                        "",
                        "            if (TimeSincePlanting > HarvestAge && Eucalyptus.IsAlive)",
                        "            {",
                        "               Eucalyptus.Harvest();",
                        "               Eucalyptus.EndCrop();         ",
                        "               TimeSincePlanting = 0;  ",
                        "            }",
                        "",
                        "            TimeSincePlanting += 1.0/365.0;",
                        "        }",
                        "    }",
                        "}",
                        "                "
                      ],
                      "Parameters": [
                        {
                          "Key": "RowSpace",
                          "Value": "2.083333"
                        },
                        {
                          "Key": "RowWidth",
                          "Value": "4"
                        },
                        {
                          "Key": "CultivarName",
                          "Value": "globulusEKB9"
                        },
                        {
                          "Key": "PlantingDate",
                          "Value": "15-Jul"
                        },
                        {
                          "Key": "HarvestAge",
                          "Value": "10"
                        },
                        {
                          "Key": "FertAmount",
                          "Value": "15"
                        }
                      ],
                      "Name": "TreeManagement",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
