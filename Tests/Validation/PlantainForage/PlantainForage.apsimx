                            "[PlantainForage].AboveGroundLive.NConc as AboveGroundLive.NConc",
                            "[PlantainForage].Leaf.Height as PlantHeight",
                            "",
                            "[DefoliationManager].Script.HarvestedWt as HarvestedWt",
                            "[DefoliationManager].Script.HarvestedN as HarvestedN",
                            "",
                            "Sum of ([DefoliationManager].Script.RemovedWt) from 1-Jul to [Clock].Today as CumulativeHarvestedWt",
                            "Sum of ([DefoliationManager].Script.RemovedN) from 1-Jul to [Clock].Today as CumulativeHarvestedN"
