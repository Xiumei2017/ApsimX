                                  "Line": "2000-08-08 [DefoliationManager].Script.Defoliate(amountDM: 60, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2000-09-05",
                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 60, amountType: \"ResidualDM\", duration: 1)",
