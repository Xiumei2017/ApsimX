                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "1999-09-15 [DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)"
                                },
