                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using System;",
                                "using Newtonsoft.Json;",
                                "using APSIM.Shared.Utilities;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Interfaces;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model",
                                "    {",
                                "        //> Links to other Apsim models",
                                "        [Link] IClock clock;",
                                "        [Link] private Zone myZone;",
                                "        [Link] ISummary summary;",
                                "",
                                "        //> User inputs from properties tab",
                                "        [Separator(\"Auxiliary outputs for reporting\")]",
                                "        [Description(\" Shade treatment:\")]",
                                "        public string ShadeTreatment { get; set; }",
                                "        [Description(\" Water deficit treatment:\")]",
                                "        public string WaterTreatment { get; set; }",
                                "        [Description(\" Date to reset cumulative values, for report (d-mmm):\")]",
                                "        public string DateForReseting { get; set; }",
                                "",
                                "        //> Outputs from this manager",
                                "        [JsonIgnore][Units(\"\")] // flag the treatment combination (shade × water deficit)",
                                "        public string TreatmentCombo { get; set; }",
                                "        [JsonIgnore][Units(\"\")] // flag the treatment combination (shade × water deficit)",
                                "        public DateTime NormalisedDate { get; set; }",
                                "        [JsonIgnore] [Units(\"\")] // Flag whether a day is start or end of simulation",
                                "        public int DayMarker { get; set; }",
                                "        [JsonIgnore] [Units(\"\")] // Date to aid reporting of cumulative values. When reset happens",
                                "        public DateTime ResetDate { get; set; }",
                                "",
                                "        //> Internal variables",
                                "        private bool seasonIsOpen;               // Flag for whether the irrigation season is open",
                                "",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            TreatmentCombo = ShadeTreatment + \"_\" + WaterTreatment;",
                                "        }",
                                "",
                                "        [EventSubscribe(\"StartOfDay\")]",
                                "        private void OnStartOfDay(object sender, EventArgs e)",
                                "        {",
                                "            NormalisedDate = DateTime.ParseExact(clock.Today.ToString(\"dd/MM\") + \"/2000\", \"dd/MM/yyyy\", null);",
                                "            ResetDate = DateTime.Parse(DateForReseting + \"-\" + clock.Today.Year);",
                                "            DayMarker = 0;",
                                "            if (clock.Today.Date == clock.StartDate.Date)",
                                "            {",
                                "                DayMarker = -1;",
                                "            }",
                                "            else if (clock.Today.Date == clock.EndDate.Date)",
                                "            {",
                                "                DayMarker = 1;",
                                "            }",
                                "        }",
                                "    }",
                                "}",
                                ""
                              ],
                              "Parameters": [
                                {
                                  "Key": "ShadeTreatment",
                                  "Value": "Some"
                                },
                                {
                                  "Key": "WaterTreatment",
                                  "Value": "All"
                                },
                                {
                                  "Key": "DateForReseting",
                                  "Value": "1-Jul"
                                }
                              ],
                              "Name": "AuxReport",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
