                                  "Line": "2000-05-16 [DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2000-06-14",
                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2000-06-14 [DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2000-07-11",
                                  "Action": "[DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2000-07-11 [DefoliationManager].Script.Defoliate(amountDM: 50, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
