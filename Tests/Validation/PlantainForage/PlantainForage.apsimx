                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2013-03-11",
                                  "Action": "[Irrigation].Apply(amount: 25)",
                                  "Line": "2013-03-11 [Irrigation].Apply(amount: 25)"
