                    },
                    {
                      "$type": "Models.Core.Zone, Models",
                      "Area": 1.0,
                      "Slope": 0.0,
                      "AspectAngle": 0.0,
                      "Altitude": 50.0,
                      "CanopyType": null,
                      "Name": "Field",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Core.Folder, Models",
                          "ShowInDocs": false,
                          "Name": "Management",
                          "ResourceName": null,
                          "Children": [
                            {
