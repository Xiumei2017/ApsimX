                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.DivideFunction, Models",
                          "Name": "ActualCurrentFS",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Functions.VariableReference, Models",
                              "VariableName": "[Inflorescence].Live.Wt",
                              "Name": "InflorescenceDM",
                              "ResourceName": null,
