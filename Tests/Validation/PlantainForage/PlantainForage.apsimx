                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.Constant, Models",
                          "FixedValue": 0.5,
                          "Units": "g/g",
                          "Name": "MaximumTR",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
