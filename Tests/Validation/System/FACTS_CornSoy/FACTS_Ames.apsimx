    {
      "$type": "Models.Core.Folder, Models",
      "ShowInDocs": false,
      "GraphsPerPage": 6,
      "Name": "Replacements",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "//========================================================",
            "//=======Systems variables for FACTS experiment assessment",
            "//========================================================",
            "",
            "//=======Dates|Phenology",
            "[Clock].Today",
            "[Clock].Today.DayOfYear",
            "[Maize].DaysAfterSowing",
            "[Maize].Phenology.CurrentStageName",
            "[Clock].Today.Year",
            "",
            "//=======Crop variables",
            "[Maize].AboveGroundLive.Wt * 10",
            "[Maize].AboveGroundLive.N * 10",
            "[Maize].AboveGroundLive.NConc * 100",
            "",
            "[Maize].Rachis.Live.Wt * 10",
            "[Maize].Rachis.Live.N * 10",
            "[Maize].Rachis.Live.NConc * 100",
            "",
            "[Maize].Husk.Live.Wt * 10",
            "[Maize].Husk.Live.N * 10",
            "[Maize].Husk.Live.NConc * 100",
            "",
            "[Maize].Rachis.Live.Wt * 10",
            "[Maize].Rachis.Live.N * 10",
            "[Maize].Rachis.Live.NConc * 100",
            "",
            "[Maize].Grain.Wt * 10",
            "[Maize].Grain.N * 10",
            "[Maize].Grain.Nconc * 100",
            "//===I Created GrainsperCob output|Check it",
            "//[Maize].Grain.GrainsperCob",
            "[Maize].Grain.Number",
            "[Maize].Grain.Size",
            "",
            "[Maize].Root.Live.Wt * 10",
            "[Maize].Root.Live.N * 10",
            "[Maize].Root.Live.NConc * 100",
            "[Maize].Root.Depth",
            "//[Maize].Root.RSRatio",
            "[Maize].Root.SpecificRootLength.FixedValue",
            "",
            "[Maize].Stem.Live.Wt * 10",
            "[Maize].Stem.Live.N * 10",
            "[Maize].Stem.Live.NConc * 100",
            "",
            "[Maize].Leaf.Live.Wt * 10",
            "[Maize].Leaf.Live.N * 10",
            "[Maize].Leaf.Live.NConc * 100",
            "[Maize].Leaf.Nconc * 100",
            "[Maize].Leaf.Dead.Wt * 10",
            "[Maize].Leaf.Dead.N * 10",
            "[Maize].Leaf.Dead.NConc * 100",
            "[Maize].Leaf.Wt * 10",
            "[Maize].Leaf.N * 10",
            "//=====For some reason I can't multiply Leaf.NConc by 100",
            "[Maize].Leaf.Nconc",
            "[Maize].Leaf.LAI",
            "[Maize].Leaf.SpecificArea",
            "[Maize].Leaf.SpecificNitrogen",
            "[Maize].Structure.LeafTipsAppeared",
            "[Maize].Leaf.LAITotal",
            "[Maize].Leaf.LAIDead",
            "//=====SpecificAreaDead and Total were created in Leaf model",
            "//[Maize].Leaf.SpecificAreaDead",
            "//[Maize].Leaf.SpecificAreaTotal",
            "//[Maize].Leaf.SpecificNitrogenTotal",
            "//[Maize].Leaf.SpecificNitrogenDead",
            "[Maize].Structure.LeafTipsAppeared",
            "[Maize].Leaf.CohortArea",
            "[Maize].Leaf.CohortParameters.SpecificLeafAreaMax",
            "[Maize].Leaf.CohortParameters.SpecificLeafAreaMin",
            "[Maize].Leaf.PlantAppearedLeafNo",
            "[Maize].Leaf.ExpandedCohortNo",
            "[Maize].Leaf.AppearedCohortNo",
            "[Maize].Leaf.DeadCohortNo",
            "[Maize].Leaf.SenescingCohortNo",
            "[Maize].Leaf.DeadCohortNo + [Maize].Leaf.SenescingCohortNo as MaizeLeafDeadCohortNo2",
            "",
            "//=======ET/CO2/NO2",
            "[Maize].Leaf.Transpiration",
            "[Field].Soil.SoilWater.Es",
            "[Maize].Leaf.Transpiration + [Field].Soil.SoilWater.Es as Maize_ET",
            "//=====N2 generated from denitrification",
            "sum([Soil].Nutrient.Natm) as Nutrient.Natm",
            "//======N2O generated from both denitrification and nitrification",
            "sum([Soil].Nutrient.N2Oatm) as Nutrient.N2Oatm",
            "//======N2O generated from both denitrification and nitrification/sum of different pools",
            "sum([Nutrient].Denitrification.N2Oatm)+ sum([Nutrient].Nitrification.N2Oatm) as Nutrient.N2Oatm_2",
            "//====== N2O/separated pools",
            "sum([Nutrient].Denitrification.N2Oatm) as NO3.Denitrification.N2Oatm",
            "sum([Nutrient].Nitrification.N2Oatm) as NH4.Nitrification.N2Oatm",
            "//======Total CO2 lost to the atmosphere",
            "sum([Soil].Nutrient.Catm) as Nutrient.Catm",
            "//======Total CO2 lost to the atmosphere/sum of different pools/should be the same value",
            "sum([Soil].Nutrient.Humic.Decomposition.Catm) + sum([Soil].Nutrient.Microbial.Decomposition.Catm) + sum([Soil].Nutrient.FOMCarbohydrate.Decomposition.Catm) +sum([Soil].Nutrient.FOMCellulose.Decomposition.Catm) + sum([Soil].Nutrient.FOMLignin.Decomposition.Catm) +sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.Catm) as Nutrient.Catm_2",
            "//======Total CO2 lost to the atmosphere/Separated pools",
            "sum([Soil].Nutrient.Humic.Decomposition.Catm) as Humic.Decomposition.Catm",
            "sum([Soil].Nutrient.Microbial.Decomposition.Catm) as Microbial.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMCarbohydrate.Decomposition.Catm) as FOMCarbohydrate.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMCellulose.Decomposition.Catm) as FOMCellulose.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMLignin.Decomposition.Catm) as FOMLignin.Decomposition.Catm",
            "sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.Catm) as SurfaceResidue.Decomposition.Catm",
            "",
            "//======Total N2O by layer",
            "sum([Soil].Nutrient.N2Oatm[1:5]) as Nutrient.N2Oatm_030",
            "sum([Soil].Nutrient.N2Oatm[6:7]) as Nutrient.N2Oatm_3060",
            "sum([Soil].Nutrient.N2Oatm[8:9]) as Nutrient.N2Oatm_6090",
            "sum([Soil].Nutrient.N2Oatm[10:11]) as Nutrient.N2Oatm_90120",
            "[Soil].Nutrient.N2Oatm[12] as Nutrient.N2Oatm_120150",
            "[Soil].Nutrient.N2Oatm[13] as Nutrient.N2Oatm_150180",
            "[Soil].Nutrient.N2Oatm[14] as Nutrient.N2Oatm_180210",
            "[Soil].Nutrient.N2Oatm[15] as Nutrient.N2Oatm_210240",
            "[Soil].Nutrient.N2Oatm[16] as Nutrient.N2Oatm_240270",
            "[Soil].Nutrient.N2Oatm[17] as Nutrient.N2Oatm_270300",
            "[Soil].Nutrient.N2Oatm[18] as Nutrient.N2Oatm_300330",
            "[Soil].Nutrient.N2Oatm[19] as Nutrient.N2Oatm_330360",
            "[Soil].Nutrient.N2Oatm[20] as Nutrient.N2Oatm_360390",
            "",
            "//=======Soil variables",
            "[Field].Soil.SoilWater.SW[4] as SW15",
            "([Field].Soil.SoilWater.SW[6] + [Field].Soil.SoilWater.SW[7]) / 2 as SW45",
            "mean([Field].Soil.SoilWater.SW[6:7]) as SW45_2 ",
            "[Field].Soil.Temperature.Value[4] as ST15",
            "([Field].Soil.Temperature.Value[6] + [Field].Soil.Temperature.Value[7]) / 2 as ST45",
            "sum([Field].Soil.Nutrient.NO3.kgha[1:5]) as NO3_0_30cm",
            "sum([Field].Soil.Nutrient.NO3.kgha[6:7]) as NO3_30_60cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[1:5]) as NH4_0_30cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[6:7]) as NH4_30_60cm",
            "[Field].Soil.SoilWater.WaterTable",
            "",
            "//=======Campbell sensors | soil_system_1_mesonet spreadsheet",
            "([Soil].Water.Volumetric[5]*1.5 + [Soil].Water.Volumetric[6]*1)/2.5 as SW30",
            "([Soil].Water.Volumetric[7] + [Soil].Water.Volumetric[8])/2 as SW60",
            "([Soil].Water.Volumetric[11]*2 + [Soil].Water.Volumetric[12]*1)/3 as SW120",
            "([Soil].Temperature.Value[3]*2 + [Soil].Temperature.Value[4]*1)/3 as ST10",
            "([Soil].Temperature.Value[5]*1.5 + [Soil].Temperature.Value[6]*1)/2.5 as ST30",
            "([Soil].Temperature.Value[7] + [Soil].Temperature.Value[8])/2 as ST60",
            "([Soil].Temperature.Value[11]*2 + [Soil].Temperature.Value[12]*1)/3 as ST120",
            "",
            "//=======Detailed soil N",
            "sum([Field].Soil.Nutrient.NO3.kgha[1:3]) as NO3_0_10cm",
            "[Field].Soil.Nutrient.NO3.kgha[4] as NO3_10_20cm",
            "[Field].Soil.Nutrient.NO3.kgha[5] as NO3_20_30cm",
            "[Field].Soil.Nutrient.NO3.kgha[6] * 2/3 as NO3_30_40cm",
            "([Field].Soil.Nutrient.NO3.kgha[6] * 1/3) + [Field].Soil.Nutrient.NO3.kgha[7] as NO3_40_60cm",
            "[Field].Soil.Nutrient.NO3.kgha[8] + ([Field].Soil.Nutrient.NO3.kgha[9] * 1/3) as NO3_60_80cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[1:3]) as NH4_0_10cm",
            "[Field].Soil.Nutrient.NH4.kgha[4] as NH4_10_20cm",
            "[Field].Soil.Nutrient.NH4.kgha[5] as NH4_20_30cm",
            "[Field].Soil.Nutrient.NH4.kgha[6] * 2/3 as NH4_30_40cm",
            "([Field].Soil.Nutrient.NH4.kgha[6] * 1/3) + [Field].Soil.Nutrient.NH4.kgha[7] as NH4_40_60cm",
            "[Field].Soil.Nutrient.NH4.kgha[8] + ([Field].Soil.Nutrient.NH4.kgha[9] * 1/3) as NH4_60_80cm",
            "",
            "//=======Root biomass per layer",
            "//10 * (sum([Maize].Root.LayerLive.Wt[1:3]) + 0.5* [Maize].Root.LayerLive.Wt[4]) as rootmass_015",
            "//10 * (0.5* [Maize].Root.LayerLive.Wt[4] + [Maize].Root.LayerLive.Wt[5]) as rootmass_1530",
            "//10 * sum([Maize].Root.LayerLive.Wt[1:5]) as rootmass_030",
            "//10 * sum([Maize].Root.LayerLive.Wt[6:7]) as rootmass_3060",
            "//10 * sum([Maize].Root.LayerLive.Wt[8:9]) as rootmass_6090",
            "//10 * sum([Maize].Root.LayerLive.Wt[10:11]) as rootmass_90120",
            "//10 * [Maize].Root.LayerLive.Wt[12] as rootmass_120150",
            "//10 * [Maize].Root.LayerLive.Wt[13] as rootmass_150180",
            "//10 * [Maize].Root.LayerLive.Wt[14] as rootmass_180210",
            "//10 * [Maize].Root.LayerLive.Wt[15] as rootmass_210240",
            "//10 * [Maize].Root.LayerLive.Wt[16] as rootmass_240270",
            "//10 * [Maize].Root.LayerLive.Wt[17] as rootmass_270300",
            "//10 * [Maize].Root.LayerLive.Wt[18] as rootmass_300330",
            "//10 * [Maize].Root.LayerLive.Wt[19] as rootmass_330360",
            "//10 * [Maize].Root.LayerLive.Wt[20] as rootmass_360390",
            "",
            "//=======Root length | from m/m2 to km/m2",
            "//=======I think Root length output is root depth, so I tried to calculate root length",
            "//(sum([Maize].Root.LayerLive.Wt[1:3]) + 0.5 * [Maize].Root.LayerLive.Wt[4]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_015",
            "//(0.5* [Maize].Root.LayerLive.Wt[4] + [Maize].Root.LayerLive.Wt[5]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_1530",
            "//sum([Maize].Root.LayerLive.Wt[1:5]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_030",
            "//sum([Maize].Root.LayerLive.Wt[6:7]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_3060",
            "//sum([Maize].Root.LayerLive.Wt[8:9]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_6090",
            "//sum([Maize].Root.LayerLive.Wt[10:11]) * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_90120",
            "//[Maize].Root.LayerLive.Wt[12] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_120150",
            "//[Maize].Root.LayerLive.Wt[13] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_150180",
            "//[Maize].Root.LayerLive.Wt[14] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_180210",
            "//[Maize].Root.LayerLive.Wt[15] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_210240",
            "//[Maize].Root.LayerLive.Wt[16] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_240270",
            "//[Maize].Root.LayerLive.Wt[17] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_270300",
            "//[Maize].Root.LayerLive.Wt[18] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_300330",
            "//[Maize].Root.LayerLive.Wt[19] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_330360",
            "//[Maize].Root.LayerLive.Wt[20] * [Maize].Root.SpecificRootLength.FixedValue / 1000 as rootlength_360390",
            "[Maize].Root.Live.Wt * [Maize].Root.SpecificRootLength.FixedValue / 1000 as totalrootlength",
            "",
            "//=======Root length density - RLD | from mm/mm3 to cm/cm3",
            "mean([Maize].Root.LengthDensity[1:5]) * 100 as lengthDensity_030",
            "mean([Maize].Root.LengthDensity[6:7]) * 100 as lengthDensity_3060",
            "mean([Maize].Root.LengthDensity[8:9]) * 100 as lengthDensity_6090",
            "mean([Maize].Root.LengthDensity[10:11]) * 100 as LengthDensity_90120",
            "[Maize].Root.LengthDensity[12] * 100 as lengthDensity_120150",
            "[Maize].Root.LengthDensity[13] * 100 as lengthDensity_150180",
            "[Maize].Root.LengthDensity[14] * 100 as lengthDensity_180210",
            "[Maize].Root.LengthDensity[15] * 100 as lengthDensity_210240",
            "[Maize].Root.LengthDensity[16] * 100 as lengthDensity_240270",
            "[Maize].Root.LengthDensity[17] * 100 as lengthDensity_270300",
            "[Maize].Root.LengthDensity[18] * 100 as lengthDensity_300330",
            "[Maize].Root.LengthDensity[19] * 100 as lengthDensity_330360",
            "[Maize].Root.LengthDensity[20] * 100 as lengthDensity_360390",
            "mean([Maize].Root.LengthDensity[1:20]) * 100 as totallengthDensity",
            "",
            "//=======Root Nitrogen per layer",
            "10 * (sum([Maize].Root.LayerLive.N[1:3]) + 0.5* [Maize].Root.LayerLive.N[4]) as rootN_015",
            "10 * (0.5* [Maize].Root.LayerLive.N[4] + [Maize].Root.LayerLive.N[5]) as rootN_1530",
            "10 * sum([Maize].Root.LayerLive.N[1:5]) as rootN_030",
            "10 * sum([Maize].Root.LayerLive.N[6:7]) as rootN_3060",
            "10 * sum([Maize].Root.LayerLive.N[8:9]) as rootN_6090",
            "10 * sum([Maize].Root.LayerLive.N[10:11]) as rootN_90120",
            "10 * [Maize].Root.LayerLive.N[12] as rootN_120150",
            "10 * [Maize].Root.LayerLive.N[13] as rootN_150180",
            "10 * [Maize].Root.LayerLive.N[14] as rootN_180210",
            "10 * [Maize].Root.LayerLive.N[15] as rootN_210240",
            "10 * [Maize].Root.LayerLive.N[16] as rootN_240270",
            "10 * [Maize].Root.LayerLive.N[17] as rootN_270300",
            "10 * [Maize].Root.LayerLive.N[18] as rootN_300330",
            "10 * [Maize].Root.LayerLive.N[19] as rootN_330360",
            "10 * [Maize].Root.LayerLive.N[20] as rootN_360390",
            "",
            "[Weather].Rain",
            "[Soil].SoilWater.Depth",
            "//[Maize].Root.LayerLive.Wt",
            "[SurfaceOrganicMatter].Wt",
            "[SurfaceOrganicMatter].Cover"
          ],
          "EventNames": [
            "[Clock].DoReport"
          ],
          "GroupByVariableName": null,
          "Name": "MaizeReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "//========================================================",
            "//=======Systems variables for FACTS experiment assessment",
            "//========================================================",
            "",
            "//=======Dates|Phenology",
            "[Clock].Today",
            "[Clock].Today.DayOfYear",
            "[Soybean].DaysAfterSowing",
            "[Soybean].Phenology.CurrentStageName",
            "",
            "//=======Crop variables",
            "[Soybean].AboveGroundLive.Wt * 10",
            "[Soybean].AboveGroundLive.N * 10",
            "[Soybean].AboveGroundLive.NConc * 100",
            "//=======I created another composite factor (AboveGround2) to better represent our measurements",
            "//[Soybean].AboveGround2.Wt * 10",
            "//[Soybean].AboveGround2.N * 10",
            "//[Soybean].AboveGround2.NConc * 100",
            "//=======Shell is equivalent to pod in measured data",
            "[Soybean].Shell.Live.Wt * 10",
            "[Soybean].Shell.Live.N * 10",
            "[Soybean].Shell.Live.NConc * 100",
            "//=======Check which one to use (I am using the total Wt because of a senescence rate)",
            "[Soybean].Shell.Wt * 10",
            "[Soybean].Shell.N * 10",
            "[Soybean].Shell.Nconc * 100",
            "",
            "//=======Pod = Shell + grain",
            "//=======I created PodLive composite biomass",
            "//=======Pod is equivalent to fruit in measured data",
            "//Soybean].PodLive.Wt * 10",
            "//[Soybean].PodLive.N * 10",
            "//[Soybean].PodLive.NConc * 100",
            "//=======Check which one to use (I am using the total Wt for shell)",
            "[Soybean].Pod.Wt * 10",
            "[Soybean].Pod.N * 10",
            "[Soybean].Pod.NConc * 100",
            "",
            "[Soybean].Grain.Wt * 10",
            "[Soybean].Grain.N * 10",
            "[Soybean].Grain.Nconc * 100",
            "",
            "[Soybean].Root.Live.Wt * 10",
            "[Soybean].Root.Live.N * 10",
            "[Soybean].Root.Live.NConc * 100",
            "[Soybean].Root.Depth",
            "//[Soybean].Root.RSRatio",
            "[Soybean].Root.SpecificRootLength.FixedValue",
            "",
            "[Soybean].Stem.Live.Wt * 10",
            "[Soybean].Stem.Live.N * 10",
            "[Soybean].Stem.Live.NConc * 100",
            "//=======Check which one to use (I am using the total Wt)",
            "[Soybean].Stem.Wt * 10",
            "[Soybean].Stem.N * 10",
            "[Soybean].Stem.Nconc * 100",
            "",
            "[Soybean].Leaf.Live.Wt * 10",
            "[Soybean].Leaf.Live.N * 10",
            "[Soybean].Leaf.Live.NConc * 100",
            "[Soybean].Leaf.Dead.Wt * 10",
            "[Soybean].Leaf.Dead.N * 10",
            "[Soybean].Leaf.Dead.NConc * 100",
            "[Soybean].Leaf.Wt * 10",
            "[Soybean].Leaf.N * 10",
            "//=====For some reason I can't multiply Leaf.NConc by 100",
            "[Soybean].Leaf.NConc",
            "[Soybean].Leaf.LAI",
            "//=======SLA units differ for maize (mm2/g) and soybean (m2/g)",
            "//=======For some reason, multiplying/dividing Leaf.SpecificArea by any number results zero",
            "//=======So I changed units of the measured data",
            "[Soybean].Leaf.SpecificArea",
            "//=======There is no output for SLN, so it was created",
            "//[Soybean].Leaf.SLN",
            "[Soybean].Leaf.Detached.Wt",
            "[Soybean].Leaf.Dead.Wt",
            "[Soybean].Leaf.Senesced.Wt*10",
            "sum of [Soybean].Leaf.Senesced.Wt*10 from [Soybean].Sowing to [Soybean].Harvesting as LeafSencescedCumWt",
            "sum of [Soybean].Leaf.Detached.Wt*10 from [Soybean].Sowing to [Soybean].Harvesting as LeafDetachedCumWt",
            "[Soybean].Leaf.Detached.Wt*10",
            "[Soybean].Leaf.NodeNumber",
            "",
            "//=======ET/CO2/NO2",
            "[Soybean].Leaf.Transpiration",
            "[Field].Soil.SoilWater.Es",
            "[Soybean].Leaf.Transpiration + [Field].Soil.SoilWater.Es as Soybean_ET",
            "//=====N2 generated from denitrification",
            "sum([Soil].Nutrient.Natm) as Nutrient.Natm",
            "//======N2O generated from both denitrification and nitrification",
            "sum([Soil].Nutrient.N2Oatm) as Nutrient.N2Oatm",
            "//======N2O generated from both denitrification and nitrification/sum of different pools",
            "sum([Nutrient].Denitrification.N2Oatm)+ sum([Nutrient].Nitrification.N2Oatm) as Nutrient.N2Oatm_2",
            "//====== N2O/separated pools",
            "sum([Nutrient].Denitrification.N2Oatm) as NO3.Denitrification.N2Oatm",
            "sum([Nutrient].Nitrification.N2Oatm) as NH4.Nitrification.N2Oatm",
            "//======Total CO2 lost to the atmosphere",
            "sum([Soil].Nutrient.Catm) as Nutrient.Catm",
            "//======Total CO2 lost to the atmosphere/sum of different pools/should be the same value",
            "sum([Soil].Nutrient.Humic.Decomposition.Catm) + sum([Soil].Nutrient.Microbial.Decomposition.Catm) + sum([Soil].Nutrient.FOMCarbohydrate.Decomposition.Catm) +sum([Soil].Nutrient.FOMCellulose.Decomposition.Catm) + sum([Soil].Nutrient.FOMLignin.Decomposition.Catm) +sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.Catm) as Nutrient.Catm_2",
            "//======Total CO2 lost to the atmosphere/Separated pools",
            "sum([Soil].Nutrient.Humic.Decomposition.Catm) as Humic.Decomposition.Catm",
            "sum([Soil].Nutrient.Microbial.Decomposition.Catm) as Microbial.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMCarbohydrate.Decomposition.Catm) as FOMCarbohydrate.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMCellulose.Decomposition.Catm) as FOMCellulose.Decomposition.Catm",
            "sum([Soil].Nutrient.FOMLignin.Decomposition.Catm) as FOMLignin.Decomposition.Catm",
            "sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.Catm) as SurfaceResidue.Decomposition.Catm",
            "",
            "//======Total N2O by layer",
            "sum([Soil].Nutrient.N2Oatm[1:5]) as Nutrient.N2Oatm_030",
            "sum([Soil].Nutrient.N2Oatm[6:7]) as Nutrient.N2Oatm_3060",
            "sum([Soil].Nutrient.N2Oatm[8:9]) as Nutrient.N2Oatm_6090",
            "sum([Soil].Nutrient.N2Oatm[10:11]) as Nutrient.N2Oatm_90120",
            "[Soil].Nutrient.N2Oatm[12] as Nutrient.N2Oatm_120150",
            "[Soil].Nutrient.N2Oatm[13] as Nutrient.N2Oatm_150180",
            "[Soil].Nutrient.N2Oatm[14] as Nutrient.N2Oatm_180210",
            "[Soil].Nutrient.N2Oatm[15] as Nutrient.N2Oatm_210240",
            "[Soil].Nutrient.N2Oatm[16] as Nutrient.N2Oatm_240270",
            "[Soil].Nutrient.N2Oatm[17] as Nutrient.N2Oatm_270300",
            "[Soil].Nutrient.N2Oatm[18] as Nutrient.N2Oatm_300330",
            "[Soil].Nutrient.N2Oatm[19] as Nutrient.N2Oatm_330360",
            "[Soil].Nutrient.N2Oatm[20] as Nutrient.N2Oatm_360390",
            "",
            "//=======Soil variables",
            "[Field].Soil.SoilWater.SW[4] as SW15",
            "([Field].Soil.SoilWater.SW[6] + [Field].Soil.SoilWater.SW[7]) / 2 as SW45",
            "[Field].Soil.Temperature.Value[4] as ST15",
            "([Field].Soil.Temperature.Value[6] + [Field].Soil.Temperature.Value[7]) / 2 as ST45",
            "sum([Field].Soil.Nutrient.NO3.kgha[1:5]) as NO3_0_30cm",
            "sum([Field].Soil.Nutrient.NO3.kgha[6:7]) as NO3_30_60cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[1:5]) as NH4_0_30cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[6:7]) as NH4_30_60cm",
            "[Field].Soil.SoilWater.WaterTable",
            "",
            "//=======Detailed soil N",
            "sum([Field].Soil.Nutrient.NO3.kgha[1:3]) as NO3_0_10cm",
            "[Field].Soil.Nutrient.NO3.kgha[4] as NO3_10_20cm",
            "[Field].Soil.Nutrient.NO3.kgha[5] as NO3_20_30cm",
            "[Field].Soil.Nutrient.NO3.kgha[6] * 2/3 as NO3_30_40cm",
            "([Field].Soil.Nutrient.NO3.kgha[6] * 1/3) + [Field].Soil.Nutrient.NO3.kgha[7] as NO3_40_60cm",
            "[Field].Soil.Nutrient.NO3.kgha[8] + ([Field].Soil.Nutrient.NO3.kgha[9] * 1/3) as NO3_60_80cm",
            "sum([Field].Soil.Nutrient.NH4.kgha[1:3]) as NH4_0_10cm",
            "[Field].Soil.Nutrient.NH4.kgha[4] as NH4_10_20cm",
            "[Field].Soil.Nutrient.NH4.kgha[5] as NH4_20_30cm",
            "[Field].Soil.Nutrient.NH4.kgha[6] * 2/3 as NH4_30_40cm",
            "([Field].Soil.Nutrient.NH4.kgha[6] * 1/3) + [Field].Soil.Nutrient.NH4.kgha[7] as NH4_40_60cm",
            "[Field].Soil.Nutrient.NH4.kgha[8] + ([Field].Soil.Nutrient.NH4.kgha[9] * 1/3) as NH4_60_80cm",
            "",
            "//=======Soil variables and detailed soil N outputs are the same as MaizeReport",
            "",
            "//=======Root biomass per layer",
            "//10 * (sum([Soybean].Root.LayerLive.Wt[1:3]) + 0.5* [Soybean].Root.LayerLive.Wt[4]) as rootmass_015",
            "//10 * (0.5* [Soybean].Root.LayerLive.Wt[4] + [Soybean].Root.LayerLive.Wt[5]) as rootmass_1530",
            "//10 * sum([Soybean].Root.LayerLive.Wt[1:5]) as rootmass_030",
            "//10 * sum([Soybean].Root.LayerLive.Wt[6:7]) as rootmass_3060",
            "//10 * sum([Soybean].Root.LayerLive.Wt[8:9]) as rootmass_6090",
            "//10 * sum([Soybean].Root.LayerLive.Wt[10:11]) as rootmass_90120",
            "//10 * sum([Soybean].Root.LayerLive.Wt[8:11]) as rootmass_90150",
            "//10 * [Soybean].Root.LayerLive.Wt[12] as rootmass_120150",
            "//10 * [Soybean].Root.LayerLive.Wt[13] as rootmass_150180",
            "//10 * [Soybean].Root.LayerLive.Wt[14] as rootmass_180210",
            "//10 * [Soybean].Root.LayerLive.Wt[15] as rootmass_210240",
            "//10 * [Soybean].Root.LayerLive.Wt[16] as rootmass_240270",
            "//10 * [Soybean].Root.LayerLive.Wt[17] as rootmass_270300",
            "//10 * [Soybean].Root.LayerLive.Wt[18] as rootmass_300330",
            "//10 * [Soybean].Root.LayerLive.Wt[19] as rootmass_330360",
            "//10 * [Soybean].Root.LayerLive.Wt[20] as rootmass_360390",
            "",
            "//=======Root length | from m/m2 to km/m2",
            "//=======I think Root length output is actually root depth, so I tried to calculate root length",
            "//(sum([Soybean].Root.LayerLive.Wt[1:3]) + 0.5 * [Soybean].Root.LayerLive.Wt[4]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_015",
            "//(0.5* [Soybean].Root.LayerLive.Wt[4] + [Soybean].Root.LayerLive.Wt[5]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_1530",
            "//sum([Soybean].Root.LayerLive.Wt[1:5]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_030",
            "//sum([Soybean].Root.LayerLive.Wt[6:7]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_3060",
            "//sum([Soybean].Root.LayerLive.Wt[8:9]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_6090",
            "//sum([Soybean].Root.LayerLive.Wt[10:11]) * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_90120",
            "//[Soybean].Root.LayerLive.Wt[12] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_120150",
            "//[Soybean].Root.LayerLive.Wt[13] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_150180",
            "//[Soybean].Root.LayerLive.Wt[14] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_180210",
            "//[Soybean].Root.LayerLive.Wt[15] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_210240",
            "//[Soybean].Root.LayerLive.Wt[16] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_240270",
            "//[Soybean].Root.LayerLive.Wt[17] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_270300",
            "//[Soybean].Root.LayerLive.Wt[18] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_300330",
            "//[Soybean].Root.LayerLive.Wt[19] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_330360",
            "//[Soybean].Root.LayerLive.Wt[20] * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as rootlength_360390",
            "//[Soybean].Root.Live.Wt * [Soybean].Root.SpecificRootLength.FixedValue / 1000 as totalrootlength",
            "",
            "//=======Root length density - RLD | from mm/mm3 to cm/cm3",
            "mean([Soybean].Root.LengthDensity[1:5]) * 100 as lengthDensity_030",
            "mean([Soybean].Root.LengthDensity[6:7]) * 100 as lengthDensity_3060",
            "mean([Soybean].Root.LengthDensity[8:9]) * 100 as lengthDensity_6090",
            "mean([Soybean].Root.LengthDensity[10:11]) * 100 as LengthDensity_90120",
            "[Soybean].Root.LengthDensity[12] * 100 as lengthDensity_120150",
            "[Soybean].Root.LengthDensity[13] * 100 as lengthDensity_150180",
            "[Soybean].Root.LengthDensity[14] * 100 as lengthDensity_180210",
            "[Soybean].Root.LengthDensity[15] * 100 as lengthDensity_210240",
            "[Soybean].Root.LengthDensity[16] * 100 as lengthDensity_240270",
            "[Soybean].Root.LengthDensity[17] * 100 as lengthDensity_270300",
            "[Soybean].Root.LengthDensity[18] * 100 as lengthDensity_300330",
            "[Soybean].Root.LengthDensity[19] * 100 as lengthDensity_330360",
            "[Soybean].Root.LengthDensity[20] * 100 as lengthDensity_360390",
            "mean([Soybean].Root.LengthDensity[1:20]) * 100 as totallengthDensity",
            "",
            "//=======Root Nitrogen per layer",
            "10 * (sum([Soybean].Root.LayerLive.N[1:3]) + 0.5* [Soybean].Root.LayerLive.N[4]) as rootN_015",
            "10 * (0.5* [Soybean].Root.LayerLive.N[4] + [Soybean].Root.LayerLive.N[5]) as rootN_1530",
            "10 * sum([Soybean].Root.LayerLive.N[1:5]) as rootN_030",
            "10 * sum([Soybean].Root.LayerLive.N[6:7]) as rootN_3060",
            "10 * sum([Soybean].Root.LayerLive.N[8:9]) as rootN_6090",
            "10 * sum([Soybean].Root.LayerLive.N[10:11]) as rootN_90120",
            "10 * [Soybean].Root.LayerLive.N[12] as rootN_120150",
            "10 * [Soybean].Root.LayerLive.N[13] as rootN_150180",
            "10 * [Soybean].Root.LayerLive.N[14] as rootN_180210",
            "10 * [Soybean].Root.LayerLive.N[15] as rootN_210240",
            "10 * [Soybean].Root.LayerLive.N[16] as rootN_240270",
            "10 * [Soybean].Root.LayerLive.N[17] as rootN_270300",
            "10 * [Soybean].Root.LayerLive.N[18] as rootN_300330",
            "10 * [Soybean].Root.LayerLive.N[19] as rootN_330360",
            "10 * [Soybean].Root.LayerLive.N[20] as rootN_360390",
            "",
            "//========Further checks",
            "[Soybean].Stem.SenescenceRate",
            "",
            "sum of [Soybean].Nodule.NFixed*10 from [Soybean].Sowing to [Soybean].Harvesting as Nfixed_kgha",
            "sum of sum([Soil].Nutrient.MineralisedN) from [Soybean].Sowing to [Soybean].Harvesting as MineralisedN_kgha"
          ],
          "EventNames": [
            "[Clock].DoReport"
