                          "$type": "Models.PMF.Plant, Models",
                          "Name": "Oats",
                          "ResourceName": "Oats",
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "",
                            "using Models.Soils;",
                            "using Models.PMF.Phen;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "using System.Xml.Serialization;",
                            "using Newtonsoft.Json;",
                            "        ",
                            "namespace Models",
                            "{",
                            "    [Serializable] ",
                            "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "    public class Script : Model",
                            "    {",
                            "        [Link] private Plant Oats;",
                            "        [Link] private Clock Clock;",
                            "        [Link] private Simulation sim;",
                            "        [Link] private Summary Summary;",
                            "        [Link(Type = LinkType.Path, Path = \"[Oats].Phenology\")]",
                            "        private Phenology phenology;",
                            "        ",
                            "        [Description(\"Cultivar\")]",
                            "        public string Cultivar { get; set; }",
                            "        ",
                            "        [JsonIgnore] public bool Sown { get; set; }",
                            "        [JsonIgnore] public bool Harvested { get; set; }",
                            "        [JsonIgnore] public bool EndSet { get; set; }",
                            "        ",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnSimulationCommencing(object sender, EventArgs e)",
                            "        {",
                            "            Sown = false;",
                            "            Harvested = false;",
                            "            EndSet = false;",
                            "        }",
                            "        ",
                            "        [EventSubscribe(\"DoManagement\")]",
                            "        private void OnDoManagement(object sender, EventArgs e)",
                            "        {",
                            "            if (Sown == false)",
                            "            {",
                            "                Oats.Sow(population: 200, cultivar: Cultivar, depth: 15, rowSpacing: 150, budNumber: 1);",
                            "                Sown = true;",
                            "            }",
                            "            ",
                            "            if (phenology.CurrentPhase.Name == \"Maturing\")",
                            "            {",
                            "                Oats.Harvest();",
                            "                Oats.EndCrop();",
                            "                Harvested = true;",
                            "                Summary.WriteMessage(this, \"Maturity reached so setting end date to stop simulation\", MessageType.Diagnostic);",
                            "            }",
                            "            ",
                            "            if ((Harvested == true) && (EndSet == false))",
                            "            {",
                            "                sim.Set(\"Clock.EndDate\", Clock.Today.AddDays(1));",
                            "                EndSet = true;",
                            "            }",
                            "        }",
                            "    }",
                            "}",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "Cultivar",
                              "Value": "Otane"
                            }
                          ],
                          "Name": "SowAndHarvest",
