                              "$type": "Models.Core.Folder, Models",
                              "ShowInDocs": true,
                              "GraphsPerPage": 6,
                              "Name": "Manager folder",
                              "ResourceName": null,
                              "Children": [
                                {
                                  "$type": "Models.Operations, Models",
                                  "Operation": null,
                                  "Name": "Operations",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "using APSIM.Shared.Utilities;",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Clock Clock;",
                                    "        [Link] Fertiliser Fertiliser;",
                                    "        ",
                                    "        [Description(\"Date to fertilise\")]",
                                    "        public string FertDate1 { get; set; }",
                                    "        [Description(\"Date to fertilise\")]",
                                    "        public string FertDate2 { get; set; }",
                                    "        [Description(\"Date to fertilise\")]",
                                    "        public string FertDate3 { get; set; }",
                                    "        [Description(\"Date to fertilise\")]",
                                    "        public string FertDate4 { get; set; }",
                                    "        ",
                                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                    "        public double Amount1 { get; set; }",
                                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                    "        public double Amount2 { get; set; }",
                                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                    "        public double Amount3 { get; set; }",
                                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                    "        public double Amount4 { get; set; }",
                                    "        ",
                                    "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                    "        public double SDSwitch { get; set; }",
                                    "        ",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "            if (DateUtilities.WithinDates(FertDate1, Clock.Today, FertDate1))",
                                    "                Fertiliser.Apply(Amount: Amount1 * SDSwitch, Type: Fertiliser.Types.NO3N);",
                                    "            if (DateUtilities.WithinDates(FertDate2, Clock.Today, FertDate2))",
                                    "                Fertiliser.Apply(Amount: Amount2, Type: Fertiliser.Types.NO3N);",
                                    "            if (DateUtilities.WithinDates(FertDate3, Clock.Today, FertDate3))",
                                    "                Fertiliser.Apply(Amount: Amount3, Type: Fertiliser.Types.NO3N);",
                                    "            if (DateUtilities.WithinDates(FertDate4, Clock.Today, FertDate4))",
                                    "                Fertiliser.Apply(Amount: Amount4 * SDSwitch, Type: Fertiliser.Types.NO3N);",
                                    "        }",
                                    "    }",
                                    "}"
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "SDSwitch",
                                      "Value": "0"
                                    },
                                    {
                                      "Key": "FertDate1",
                                      "Value": "05-Aug"
                                    },
                                    {
                                      "Key": "FertDate2",
                                      "Value": "01-Oct"
                                    },
                                    {
                                      "Key": "FertDate3",
                                      "Value": "20-Oct"
                                    },
                                    {
                                      "Key": "FertDate4",
                                      "Value": "25-Nov"
                                    },
                                    {
                                      "Key": "Amount1",
                                      "Value": "0"
                                    },
                                    {
                                      "Key": "Amount2",
                                      "Value": "0"
                                    },
                                    {
                                      "Key": "Amount3",
                                      "Value": "0"
                                    },
                                    {
                                      "Key": "Amount4",
                                      "Value": "0"
                                    }
                                  ],
                                  "Name": "Fertilise",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Operations, Models",
                                  "Operation": [
                                    {
                                      "$type": "Models.Operation, Models",
