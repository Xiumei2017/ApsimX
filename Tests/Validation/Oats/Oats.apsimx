                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Models.Soils;",
                                "using System.Globalization;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using Models.PMF;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using APSIM.Shared.Utilities;",
                                "using Models.Core;",
                                "using System;",
                                "using Models.Climate;",
                                "",
                                "// This script simulates a rainshelter, it controls the amount of rainfall (=0.0) and radiation (=95% of weather)",
                                "// It does that for a period between two dates, as well as at sporadic dates",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Weather Met;",
                                "        [Link] Clock Clock;",
                                "    ",
                                "        [Description(\"Start date: \")]",
                                "        public DateTime StartDate { get; set; }",
                                "        [Description(\"End date: \")]",
                                "        public DateTime EndDate { get; set; }",
                                "         [Description(\"Other dates: \")]",
                                "         public string OtherDateString  { get; set; }",
                                "         ",
                                "         private const string dateFormat = \"dd/MM/yyyy\";",
                                "",
                                "         private DateTime[] OtherDates;",
                                "         private double todaysRain;",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                "        {",
                                "            //gather the dates the variables will be controlled",
                                "            string[] auxDates = OtherDateString.Split(new Char []{' ',','});",
                                "            OtherDates = new DateTime[auxDates.Length];",
                                "            for (int i = 0; i < auxDates.Length; i++)",
                                "                OtherDates[i] = DateTime.ParseExact(auxDates[i], dateFormat, CultureInfo.InvariantCulture);",
                                "        }",
                                "",
                                "        [EventSubscribe(\"PreparingNewWeatherData\")]",
                                "        private void OnPreparingNewWeatherData(object sender, EventArgs e)",
                                "        {",
                                "            if ((Clock.Today.Date >= StartDate.Date) && (Clock.Today.Date <= EndDate.Date))",
                                "            {",
                                "                todaysRain = Met.Rain;",
                                "                changeMetData();",
                                "            }",
                                "            else",
                                "            {",
                                "                for (int i = 0; i < OtherDates.Length; i++)",
                                "                    if (Clock.Today.Date == OtherDates[0].Date)",
                                "                        changeMetData();",
                                "            }",
                                "",
                                "            // rain shelter partial day cover",
                                "            if (Clock.Today.Date == DateTime.ParseExact(\"01/09/2017\", dateFormat, CultureInfo.InvariantCulture).Date)",
                                "                Met.Rain -= 2.0;",
                                "            ",
                                "            // rain shelter cover removed for weekend",
                                "            if ((Clock.Today.Date == DateTime.ParseExact(\"03/06/2017\", dateFormat, CultureInfo.InvariantCulture).Date)||(Clock.Today.Date == DateTime.ParseExact(\"04/06/2017\", dateFormat, CultureInfo.InvariantCulture).Date))",
                                "            {",
                                "                Met.Rain = todaysRain;",
                                "                Met.Radn /= 0.95;",
                                "            }",
                                "        }",
                                "",
                                "        private void changeMetData()",
                                "        {",
                                "            Met.Rain *= 0.0;",
                                "            Met.Radn *= 0.95;",
                                "        }",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "StartDate",
                                  "Value": "10/17/2016 00:00:00"
                                },
                                {
                                  "Key": "EndDate",
                                  "Value": "06/30/2017 00:00:00"
                                },
                                {
                                  "Key": "OtherDateString",
                                  "Value": "27/07/2017 28/07/2017 09/08/2017 13/08/2017 14/08/2017 31/08/2017"
                                }
                              ],
                              "Name": "ClimateControl",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Models.Interfaces;",
                                "using APSIM.Shared.Utilities;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using Models.Core;",
                                "using System;",
                                "using Models.Soils.Nutrients;",
                                "",
                                "// This script performs management actions that are not common to all treatments",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] private Clock Clock;",
                                "        [Link] private Irrigation Irrigation;",
                                "        [Link] private Fertiliser Fert;",
                                "        [Link] private Soil ThisSoil;",
                                "        [Link(ByName = true)] private ISolute no3;",
                                "        [Link(ByName = true)] private ISolute nh4;",
                                "        [Link]",
                                "        private IPhysical soilPhysical;",
                                "",
                                "        [Description(\"Allow irrigation to be applied?\")]",
                                "        public bool IrrFactor { get; set; }",
                                "        [Description(\"Amount of fertiliser to be applied (kg/ha)\")]",
                                "        public double NitFactor { get; set; }",
                                "",
                                "",
                                "        private void SetSoilLayers()",
                                "        {",
                                "        ",
                                "            int i = 0;",
                                "",
                                "            if (soilPhysical.Thickness.Length != 7)",
                                "               throw new Exception(\"Soil layer exception\");",
                                "",
                                "            if ((IrrFactor == false) && (NitFactor == 300))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{108,12,7,5,4,3,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {55,30,25,12,3,5,5});",
                                "            }   ",
                                "            else if ((IrrFactor == false) && (NitFactor == 50))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{14.2,3.6,3.2,1.0,2.8,3.7,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {34,16.8,15.8,7.7,1.8,2.3,5});",
                                "            }   ",
                                "            else if ((IrrFactor == false) && (NitFactor == 0))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{3.7,3.5,4.1,1.2,2.1,2.3,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {18,13.7,10.8,4.2,1.9,2.8,5});",
                                "            }   ",
                                "            else if ((IrrFactor == true) && (NitFactor == 300))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{1.8,1.8,3.0,2.3,2.4,1.8,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {12.6,6.4,5.3,2.8,2.2,2.2,5});",
                                "            }   ",
                                "            else if ((IrrFactor == true) && (NitFactor == 50))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{1.9,1.5,3.5,2.0,2.6,1.8,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {8.5,5.4,1.9,1.5,1.8,2.7,5});",
                                "            }",
                                "            else if ((IrrFactor == true) && (NitFactor == 0))",
                                "            {",
                                "                nh4.SetKgHa(SoluteSetterType.Fertiliser,new double[]{2.5,2.4,3.1,3.4,5.6,2.5,3});",
                                "                no3.SetKgHa(SoluteSetterType.Fertiliser,new double[] {5.6,3.9,1.3,1.0,1.3,2.2,5});",
                                "            }",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "",
                                "            if (Clock.Today.Date == DateTime.Parse(\"02-Jun-2017\"))",
                                "               SetSoilLayers();",
                                "",
                                "        ",
                                "            // Oats - Irrigation on dryland plots only, after harvest",
                                "            if (IrrFactor == false)",
                                "            {",
                                "                if ((Clock.Today.Date == DateTime.Parse(\"25-May-2017\")) || (Clock.Today.Date == DateTime.Parse(\"26-May-2017\")))",
                                "                    Irrigation.Apply(50.0);",
                                "",
                                "                if (Clock.Today.Date == DateTime.Parse(\"29-May-2017\"))",
                                "                if (NitFactor == 300)",
                                "                    Irrigation.Apply(64.0);",
                                "",
                                "                if (Clock.Today.Date == DateTime.Parse(\"30-May-2017\"))",
                                "                {",
                                "                    if (NitFactor == 0)",
                                "                        Irrigation.Apply(30.3);",
                                "                    if (NitFactor == 50)",
                                "                        Irrigation.Apply(51.0);",
                                "                }",
                                "            }",
                                "",
                                "            // Oats - Irrigation on all 300N plots plus dryland 50N plots",
                                "            if (Clock.Today.Date == DateTime.Parse(\"13-Dec-2017\"))",
                                "            {",
                                "                if (NitFactor == 300)",
                                "                    Irrigation.Apply(50.0);",
                                "                if ((NitFactor == 50) && (IrrFactor == false))",
                                "                    Irrigation.Apply(50.0);",
                                "            }",
                                "",
                                "            // Oats - Fertiliser for irrigated plots only, on sowing",
                                "            if (Clock.Today.Date == DateTime.Parse(\"05-Jul-2017\"))",
                                "            if (IrrFactor == true)",
                                "            {",
                                "                if (NitFactor == 0)",
                                "                    Fert.Apply(40, Models.Fertiliser.Types.UreaN, 10);",
                                "                if (NitFactor == 50)",
                                "                    Fert.Apply(85, Models.Fertiliser.Types.UreaN, 10);",
                                "                if (NitFactor == 300)",
                                "                    Fert.Apply(270, Models.Fertiliser.Types.UreaN, 10);",
                                "            }",
                                "        }",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "NitFactor",
                                  "Value": "0"
                                },
                                {
                                  "Key": "IrrFactor",
                                  "Value": "False"
                                }
                              ],
                              "Name": "TreatmentSpecificActions",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Newtonsoft.Json;",
                                "using APSIM.Shared.Utilities;",
                                "using System.Xml.Serialization;",
                                "using Models;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using System.Text;",
                                "using System.Collections.Generic;",
                                "using Models.Core;",
                                "using System;",
                                "using Models.Soils.Nutrients;",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] Clock Clock;",
                                "        [Link] Plant Oats;",
                                "        [Link] Zone zone;",
                                "                    ",
                                "        [JsonIgnore] public bool InitialDay { get; set; }",
                                "        ",
                                "        [JsonIgnore] public double LeafExpandedPosition { get; set; }",
                                "        [JsonIgnore] public double LeafAppearedPosition { get; set; }",
                                "        [JsonIgnore] public double ExpandedLeafNoYesterday { get; set; }",
                                "        [JsonIgnore] public double AppearedLeafNoYesterday { get; set; }",
                                "        [JsonIgnore] public double MostRecentlyExpandedLeafSize { get; set; }",
                                "        [JsonIgnore] public double MostRecentlyAppearedLeafMaxSize { get; set; }",
                                "        ",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                "        {",
                                "            InitialDay = true;",
                                "            LeafExpandedPosition = 0;",
                                "            LeafAppearedPosition = 0;",
                                "            ExpandedLeafNoYesterday = 0;",
                                "            AppearedLeafNoYesterday = 0;",
                                "            MostRecentlyExpandedLeafSize = 0;",
                                "            MostRecentlyAppearedLeafMaxSize = 0;",
                                "        }",
                                "        ",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            ExpandedLeafNoYesterday = Convert.ToDouble(zone.Get(\"Oats.Leaf.ExpandedCohortNo\"));",
                                "            AppearedLeafNoYesterday = Convert.ToDouble(zone.Get(\"Oats.Leaf.AppearedCohortNo\"));",
                                "        }",
                                "        ",
                                "        [EventSubscribe(\"DoManagementCalculations\")]",
                                "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                                "        {",
                                "            if (Convert.ToDouble(zone.Get(\"Oats.Leaf.ExpandedCohortNo\")) > ExpandedLeafNoYesterday)",
                                "            {",
                                "                LeafExpandedPosition = Convert.ToDouble(zone.Get(\"Oats.Leaf.ExpandedCohortNo\"));",
                                "                MostRecentlyExpandedLeafSize = (double)zone.Get(\"Oats.Leaf.CohortSize[\" + (int)LeafExpandedPosition + \"]\");",
                                "            }",
                                "            ",
                                "            if (Convert.ToDouble(zone.Get(\"Oats.Leaf.AppearedCohortNo\")) > AppearedLeafNoYesterday)",
                                "            {",
                                "                LeafAppearedPosition = Convert.ToDouble(zone.Get(\"Oats.Leaf.AppearedCohortNo\"));",
                                "                MostRecentlyAppearedLeafMaxSize = (double)zone.Get(\"Oats.Leaf.CohortParameters.MaxArea.Value()\");",
                                "            }",
                                "            ",
                                "        }",
                                "    }",
                                "}",
                                "       "
                              ],
