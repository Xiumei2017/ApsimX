                                "[Oats].AboveGround.Wt as AboveBiomass",
                                "[Oats].Leaf.Live.N as LeafN",
                                "[Oats].Stem.Live.N as StemN",
                                "[Oats].AboveGround.N as AboveN",
                                "[ExtraVariables].Script.AccumTotalLeachedN as TotalLeachedN_Cum",
                                "[ExtraVariables].Script.AccumUptakeN as UptakeN_Cum",
                                "[ExtraVariables].Script.AccumRainfall as Rainfall_Cum",
                                "[ExtraVariables].Script.AccumIrrigation as AppliedIrrigation_Cum",
                                "[ExtraVariables].Script.AccumFertiliser as AppliedFertiliserN_Cum",
