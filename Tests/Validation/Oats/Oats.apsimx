                            "[Irrigation].IrrigationApplied",
                            "[Oats].Leaf.Fw",
                            "([Oats].Leaf.Transpiration + [Soil].SoilWater.Es + [MicroClimate].PrecipitationInterception) as ET",
                            "[MicroClimate].PrecipitationInterception as Interception",
                            "[Oats].Leaf.Transpiration as Transpiration",
                            "[Soil].SoilWater.Es as Evaporation",
                            "[Soil].SoilWater.Drainage as Drainage",
                            "[Soil].SoilWater.Runoff as Runoff",
                            "sum([Soil].Water.MM) as TotalSoilWater",
                            "",
                            "sum([Soil].Nutrient.MineralisedN) as MineralisedN",
                            "[Fertiliser].NitrogenApplied as FertiliserN",
                            "sum([Soil].Nutrient.Natm) as DenitrifiedN",
                            "([Soil].SoilWater.LeachUrea+[Soil].SoilWater.LeachNH4+[Soil].SoilWater.LeachNO3) as NLeached",
                            "[SurfaceOrganicMatter].N as TotalSurfOMN",
                            "sum([Soil].Nutrient.FOM.N) as TotalFOMN",
                            "sum([Soil].Nutrient.Microbial.N) as TotalMicrobialN",
                            "sum([Soil].Nutrient.Humic.N) as TotalHumicN",
                            "(sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as TotalSoilN",
                            "sum([Soil].Urea.kgha) as TotalUrea",
                            "sum([Soil].NH4.kgha) as TotalNH4",
                            "sum([Soil].NO3.kgha) as TotalNO3",
                            "",
                            "sum([Soil].Nutrient.DenitrifiedN) as Denitrification",
                            "",
                            "[Soil].SoilWater.FlowNO3",
                            "([Soil].SoilWater.Flux[5] + [Soil].SoilWater.Flow[5]) as Drainage70cm",
                            "([Soil].SoilWater.FlowNH4[5] + [Soil].SoilWater.FlowNO3[5]) as Leaching70cm",
                            "",
                            "sum of ([Soil].SoilWater.Flux[5] + [Soil].SoilWater.Flow[5]) from [Clock].StartOfSimulation to [Clock].Today as cumDrainage70cm",
                            "sum of ([Soil].SoilWater.FlowNH4[5] + [Soil].SoilWater.FlowNO3[5]) from [Clock].StartOfSimulation to [Clock].Today as cumLeaching70cm"
                          ],
