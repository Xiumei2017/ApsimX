                                "[ExtraVariables].Script.CropAboveGroundBiomassN as UptakeN_Cum",
                                "[ExtraVariables].Script.AccumSoilOMMineralisedToLayer as SoilOMMineralisedNToGivenLayer_Cum",
                                "([ExtraVariables].Script.AccumSoilOMMineralisedToLayer+[ExtraVariables].Script.AccumSurfaceOMMineralisation) as MineralisedNToGivenLayer_Cum",
                                "[ExtraVariables].Script.AccumDenitrifiedNToLayer as DenitrifiedNToGivenLayer_Cum",
