                                "[CropManagement].Script.HarvestedWt as HarvestedCropBiomass",
                                "[CropManagement].Script.HarvestedN as HarvestedCropN",
                                "[CropManagement].Script.HarvestedNconc as HarvestedCropNconc",
                                "[CropManagement].Script.CropYield as CropYield",
                                "",
                                "[ExtraVariables].Script.depthForReporting as ReportDepth",
                                "[CropManagement].Script.SowDOY as SowingDOY",
                                "[CropManagement].Script.HarvestDOY as HarvestingDOY",
                                "[ExtraVariables].Script.AccumLightInterception as AccumLightInterc",
                                "[CropManagement].Script.CoverCropCultivar as CoverCropCultivar",
                                "[Oats].Leaf.Live.Wt as LeafBiomass",
