                        "[CropManagement].Script.CurrentCrop as CropSpecies",
                        "",
                        "sum([Soil].Water.MM) as SoilWater_Total",
                        "sum([Soil].Urea.kgha) as SoilUrea_Total",
                        "sum([Soil].NH4.kgha) as SoilNH4_Total",
                        "sum([Soil].NO3.kgha) as SoilNO3_Total",
                        "(sum([Soil].Urea.kgha) + sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as SoilMineralN_Total",
                        "sum([Soil].Nutrient.FOM.N) as SoilFOMN_Total",
                        "sum([Soil].Nutrient.Microbial.N) as SoilMicrobialN_Total",
                        "sum([Soil].Nutrient.Humic.N) as SoilHumicN_Total",
