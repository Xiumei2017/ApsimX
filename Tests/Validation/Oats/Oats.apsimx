                                    {
                                      "$type": "Models.PMF.Cultivar, Models",
                                      "Command": [
                                        "[Phenology].MinimumLeafNumber.FixedValue = 9",
                                        "[Phenology].VrnSensitivity.FixedValue = 0",
                                        "[Phenology].PpSensitivity.FixedValue = 0",
                                        "[Structure].Phyllochron.BasePhyllochron.FixedValue = 110",
                                        "[Leaf].ExtinctionCoeff.FixedValue = 0.5",
                                        "[Leaf].CohortParameters.MaxArea.AreaLargestLeaves.FixedValue = 3593",
