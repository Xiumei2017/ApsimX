                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "using Models.Soils.Nutrients;",
                                    "using System;",
                                    "using Models.Core;",
                                    "using System.Collections.Generic;",
                                    "using System.Text;",
                                    "using Models.Soils;",
                                    "using Models.Soils.Nutrients;",
                                    "using Models.PMF;",
                                    "using Models;",
                                    "using System.Xml.Serialization;",
                                    "using APSIM.Shared.Utilities;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable] ",
                                    "    public class Script : Model",
                                    "    {",
                                    "    }",
                                    "}",
                                    "       "
                                  ],
                                  "Parameters": [],
                                  "Name": "Harvesting",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Manager, Models",
                                  "CodeArray": [
                                    "",
                                    "using Models.PMF.Interfaces;",
                                    "using Newtonsoft.Json;",
                                    "using System;",
                                    "using System.Collections.Generic;",
                                    "using Models.Core;",
                                    "using Models.PMF;",
                                    "using Models.PMF.Interfaces;",
                                    "using System.Xml.Serialization;",
                                    "using APSIM.Shared.Utilities;",
                                    "using Models.Soils;",
                                    "using Models.Management;",
                                    "",
                                    "namespace Models",
                                    "{",
                                    "    [Serializable] ",
                                    "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                    "    public class Script : Model",
                                    "    {",
                                    "        [Link] Plant Oats;",
                                    "        [Link] Clock Clock;",
                                    "        [Link] BiomassRemovalEvents toa; ",
                                    "",
                                    "        [Description(\"Cultivar\")]",
                                    "        public string Cultivar { get; set; }",
                                    "        [Description(\"Management\")]",
                                    "        public int Management { get; set; }",
                                    "",
                                    "        private string SowDate;",
                                    "        private string CutDate1;",
                                    "        private string CutDate2;",
                                    "",
                                    "",
                                    "",
                                    "        ",
                                    "        [EventSubscribe(\"StartOfSimulation\")]",
                                    "        private void OnSimulationCommencing(object sender, EventArgs e)",
                                    "        {",
                                    "            ",
                                    "            if (Management == 1)",
                                    "            {",
                                    "            SowDate = \"9-feb\";",
                                    "            CutDate1 = \"\";",
                                    "            CutDate2 = \"\";",
                                    "            }",
                                    "            else if (Management == 2)",
                                    "            {",
                                    "            SowDate = \"8-mar\";",
                                    "            CutDate1 = \"\";",
                                    "            CutDate2 = \"\";",
                                    "            }",
                                    "            else if (Management == 3)",
                                    "            {",
                                    "            SowDate = \"5-apr\";",
                                    "            CutDate1 = \"\";",
                                    "            CutDate2 = \"\";",
                                    "            }",
                                    "            else if (Management == 4)",
                                    "            {",
                                    "            SowDate = \"9-feb\";",
                                    "            CutDate1 = \"12-apr\";",
                                    "            CutDate2 = \"10-may\";",
                                    "            }",
                                    "            else if (Management == 5)",
                                    "            {",
                                    "            SowDate = \"8-mar\";",
                                    "            CutDate1 = \"9-may\";",
                                    "            CutDate2 = \"6-jun\";",
                                    "            }",
                                    "            else if (Management == 6)",
                                    "            {",
                                    "            SowDate = \"5-apr\";",
                                    "            CutDate1 = \"6-jun\";",
                                    "            CutDate2 = \"4-jul\";",
                                    "            }",
                                    "",
                                    "        }",
                                    "        ",
                                    "        [EventSubscribe(\"DoManagement\")]",
                                    "        private void OnDoManagement(object sender, EventArgs e)",
                                    "        {",
                                    "",
                                    "            if (DateUtilities.WithinDates(SowDate,Clock.Today,SowDate) )",
                                    "            {",
                                    "                Oats.Sow(population:95, cultivar: Cultivar, depth:40, rowSpacing:250);",
                                    "            }",
                                    "",
                                    "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                                    "            if (CutDate1 !=\"\")",
                                    "                if (DateUtilities.WithinDates(CutDate1,Clock.Today,CutDate1))",
                                    "                {",
                                    "                    //Remove.SetPhenologyStage = 2.0;",
                                    "                    var Panicle = Oats.FindChild<IHasDamageableBiomass>(\"Panicle\");",
                                    "                    var Leaf = Oats.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                                    "                    var Stem = Oats.FindChild<IHasDamageableBiomass>(\"Stem\");",
                                    "                    var Grain = Oats.FindChild<IHasDamageableBiomass>(\"Grain\");",
                                    "                    var Root = Oats.FindChild<IHasDamageableBiomass>(\"Root\");",
                                    "                    Panicle.RemoveBiomass(liveToRemove: 1.0, deadToRemove: 0.0, liveToResidue: 0.0, deadToResidue: 0.0);",
                                    "                    Leaf.RemoveBiomass(liveToRemove: 0.8, deadToRemove: 0.0, liveToResidue: 0.0, deadToResidue: 0.0);",
                                    "                    Stem.RemoveBiomass(liveToRemove: 0.8, deadToRemove: 0.0, liveToResidue: 0.0, deadToResidue: 0.0);",
                                    "                    Grain.RemoveBiomass(liveToRemove: 1.0, deadToRemove: 0.0, liveToResidue: 0.0, deadToResidue: 0.0);",
                                    "                    Root.RemoveBiomass(liveToRemove: 0.0, deadToRemove: 0.0, liveToResidue: 0.0, deadToResidue: 0.0);",
                                    "",
                                    "                }",
                                    "            //Set up  array of remove fractions to send with Cut method.  Each member in the array corresponds to an organ in the same order they are set up in.",
                                    "            if (CutDate2 !=\"\")",
                                    "                if (DateUtilities.WithinDates(CutDate2,Clock.Today,CutDate2))",
                                    "                {",
                                    "                    toa.Remove();",
                                    "                }",
                                    "",
                                    "            ",
                                    "        }",
                                    "    }",
                                    "}",
                                    "                "
                                  ],
                                  "Parameters": [
                                    {
                                      "Key": "Cultivar",
                                      "Value": "Coolibah"
                                    },
                                    {
                                      "Key": "Management",
                                      "Value": "0"
                                    }
                                  ],
                                  "Name": "SowAndCut",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                }
                              ],
                              "Enabled": true,
                              "ReadOnly": false
