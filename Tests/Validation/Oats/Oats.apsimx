                                  "$type": "Models.Operations, Models",
                                  "Operation": [
                                    {
                                      "$type": "Models.Operation, Models",
                                      "Enabled": true,
                                      "Date": "2007-05-24",
                                      "Action": "[Oats].Sow(population:95, cultivar:\"Coolibah\", depth:20, rowSpacing:250);",
                                      "Line": "2007-05-24 [Oats].Sow(population:95, cultivar:\"Coolibah\", depth:20, rowSpacing:250);"
                                    }
