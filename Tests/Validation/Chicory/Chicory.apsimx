                                  "Operation": [
                                    {
                                      "$type": "Models.Operation, Models",
                                      "Enabled": true,
                                      "Date": "1997-05-16",
                                      "Action": "[Chicory].Sow(population: 250, cultivar: \"Puna\", depth: 10, rowSpacing: 150)",
                                      "Line": "1997-05-16 [Chicory].Sow(population: 250, cultivar: \"Puna\", depth: 10, rowSpacing: 150)"
                                    }
                                  ],
