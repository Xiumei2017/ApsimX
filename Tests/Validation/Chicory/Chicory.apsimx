            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "GraphsPerPage": 6,
              "Name": "AFSRC_02",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Factorial.Experiment, Models",
                  "DisabledSimNames": null,
                  "Name": "AFSRC_02",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This simulation setup was based on a field experiment run for 3 years at the Appalachian Farming Systems Research Center in southern West Virginia, USA.  The sol at this location was a Ramsey soil (loamy, siliceous, subactive, mesic Lithic Dystrudept).  The study aimed to determine whether fertilizer N would influence forage chicory (cultivar '*Puna*') nutritive value and NO3-N concentration.  The treatments consisted of five N rates (0, 80, 160, 240, or 480 kg N/ha) replicated three times in a randomized block design. Swards were clipped at 6-wk intervals during the growing season.  Yield was reported either as annual totals or seasonal, using these the values for each harvest event were arbitrarily inferred (treat this data as rough approximation).  \r\nMet data was based on nearby location obtained from NOAA.  The data set was largely complete except for solar radiation, which was added from an alternative interpolated set for this location, also from NOAA.  \r\nInformation to assemble the soil data was obtained from USGS.\r\n\r\n\r\nReferences:  \r\nBelesky, D.P.; Turner, K.E.; Ruckle, J.M. 2000. Influence of nitrogen on productivity and nutritive value of forage chicory. Agronomy Journal, 92(3): 472-478.\r\n",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
