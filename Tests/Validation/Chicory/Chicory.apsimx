                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Simulation based on unpublished data from a chicory establishment trial at Scott farm, Hamilton, New Zealand, run from 2009 to 2010.  Trial plots were sown with chicory, cultivar '*Choice*'; direct drilled after spraying existing pasture with herbicide.  Sward was mechanically mowned.  Measurements comprised of yield (plate meter technique) and population (quadrat method).  \r\nData supplied by Julia Lee, DairyNZ.\r\n",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
