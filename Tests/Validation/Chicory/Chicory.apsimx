                {
                  "$type": "Models.Core.Folder, Models",
                  "ShowInDocs": true,
                  "GraphsPerPage": 6,
                  "Name": "ScottFarmD",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Experiment, Models",
                      "DisabledSimNames": null,
                      "Name": "ScottFarmD",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Memo, Models",
                          "Text": "Simulation based on a field trial, part of ESP farmlet, run at Scott farm, Hamilton, New Zealand, from 2010 to 2011.  Trial plots were sown with chicory, cultivar '*Choice*'; seeds drilled (6 kg/ha) and broadcasted (2 kg/ha).  Measurements taken comprised plant density (quadrat method) and yield (raising plate techinique).  Sward was grazed by dairy cows.  The trial was similar to that of C17a, but is noted that yields here were much lower due to the dry period after sowing which reduced plant establishment and hence density.  \r\nData supplied by Julia Lee, DairyNZ.\r\n",
                          "Name": "Memo",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
