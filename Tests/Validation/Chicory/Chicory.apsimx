            {
              "$type": "Models.Core.Folder, Models",
              "ShowInDocs": true,
              "GraphsPerPage": 6,
              "Name": "RELARC_01",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Factorial.Experiment, Models",
                  "DisabledSimNames": null,
                  "Name": "RELARC_01",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This simulation was adapted from a defoliation trial conducted in 1998-1999, at Russell E. Larson Agricultural Research Center, Pennsylvania, USA.  The trial consisted of small plots where two chicory cultivars ('*Puna*' and '*Feast*') were sown separately in May-1997 (at 4.5 kg seed/ha).  Plots were fertilized with 27 kgP and 72 kgK/ha in October 1997 and April 1999. Fertilizer N was applied at 56 kg/ha in June and July of 1998 and 1999.  Treatments were replicated five times and the soil at the site was a Hagerstown silt loam (fine, mixed, semiactive mesic Typic Hapludalfs).  \r\nEach plot was divided in two, one-half was harvested every 3 wk and the other half every 5 wk. Each strip was cut to a 7-cm height with a rotary mower.  Dates for each cut were given, but only annual and treatment yields are reported;  population numbers were provided for few specific dates.  Yield for each harvest were arbitrarily inferred, therefore they should be seen as rough indication only.  \r\nMet file was built using data obtained from NOAA website.  The data set was largely complete except for solar radiation, which was added from an alternative interpolated set for this location, also from NOAA.  \r\nInformation to assemble the soil data was obtained from USGS.\r\n\r\nReferences:  \r\nSanderson, M.A.; Labreveux, M.; Hall, M.H.; Elwinger, G.F. 2003. Forage yield and persistence of chicory and english plantain. Crop Science, 43: 995-1000.",
                      "Name": "Memo",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Factorial.Factors, Models",
                      "Name": "Factors",
                      "ResourceName": null,
                      "Children": [
                        {
