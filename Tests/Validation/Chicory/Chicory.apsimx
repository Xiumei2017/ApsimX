                                  "Enabled": true,
                                  "Date": "1999-04-28",
                                  "Action": " [Chicory].Sow(population: 250, cultivar: \"Puna\", depth: 10, rowSpacing: 150)",
                                  "Line": "1999-04-28  [Chicory].Sow(population: 250, cultivar: \"Puna\", depth: 10, rowSpacing: 150)"
